#!/usr/bin/env bash
# darkbotctl – lokale Steuerung von DarkBot auf macOS.
#
# darkbotctl build | deploy             bauen (nur explizit) | Release nach ~/Library/Application Support/DarkBot
# darkbotctl app                        ein Klick: Gateway sicherstellen, ggf. konfigurierte Capture, Cockpit öffnen
# darkbotctl up [--no-open] | down      Gateway starten | Capture geordnet stoppen, dann Gateway stoppen
# darkbotctl restart-gateway            nur Gateway neu (Capture läuft weiter, Reporter verbindet neu)
# darkbotctl status | open | logs [gateway|capture]
# darkbotctl capture start <sekunden> | stop | status
# darkbotctl install-apps               DarkBot.app auf dem Schreibtisch (nach jeder Änderung dieser Datei)
#
# Grundsätze: Das Fenster ist nur eine Ansicht; Schließen beendet keinen Prozess. Prozesse gehören
# launchd: das Gateway (KeepAlive) und je Lauf genau eine Capture (kein Neustart, kein Login-Start).
# Jede Lebenszyklus-Änderung läuft unter einem kurzen Lock; während eines Capture-Drains wird keiner gehalten.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_HOME="$HOME/Library/Application Support/DarkBot"
LOGDIR="$HOME/Library/Logs/DarkBot"
RUNDIR="$HOME/.darkbot/run"
LABEL="com.darkbot.gateway"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
CAPTURE_LABEL="com.darkbot.capture"
# Deliberately outside LaunchAgents: a capture never starts by itself at login.
CAPTURE_PLIST="$RUNDIR/$CAPTURE_LABEL.plist"
DOMAIN="gui/$(id -u)"
URL="http://127.0.0.1:8787/"
SOCK="/tmp/darkbot/project0.sock"
GEN_LOCK="$HOME/.darkbot/p0.generation.lock"
GATEWAY_BUILD="$ROOT/gateway/target/release/darkbot-gateway"
DIST_BUILD="$ROOT/frontend/dist"
CAPTURE_BUILD="$ROOT/project_0/native/target/release/p0-market-capture-reported"
CAPTURE_BIN="$APP_HOME/current/p0-market-capture-reported"
P0CTL_BUILD="$ROOT/project_0/native/target/release/p0ctl"
P0A_BUILD="$ROOT/project_0/native/target/release/p0-analytics-reporter"
APP_CONF="${DARKBOT_APP_CONF:-$HOME/.darkbot/app.conf}"
LOCKFILE="$RUNDIR/lifecycle.lock"
RESULT_FILE="$RUNDIR/capture.result"
LAUNCH_FILE="$RUNDIR/capture.launch"
STOPPING_FILE="$RUNDIR/capture.stopping"
# Explicit user intent: a stopped capture must not auto-restart on the next desktop click.
USER_STOP_FILE="$RUNDIR/capture.user_stopped"
# Longest orderly capture stop (drain + seal) this tool waits for; also launchd's ExitTimeOut.
STOP_BUDGET_S=330
STOP_SENT=0
STOP_LAUNCH=""
STOP_PID=""
PORT=8787
GEN_FILE="$HOME/.darkbot/p0.generation"
ENV_FILES="$ROOT/project_0/config/market.public.env:$ROOT/project_0/.env"
DOWN_FILE="$RUNDIR/lifecycle.down"
# Tests must explicitly opt into a private namespace. No production label/path may leak into it.
if [ -n "${DARKBOT_TEST_DIR:-}" ]; then
  case "$DARKBOT_TEST_DIR" in /private/tmp/darkbot-test.*) ;; *) die_test=1; echo "invalid isolated test directory" >&2; exit 2;; esac
  [ -f "$DARKBOT_TEST_DIR/.isolated" ] || exit 2
  APP_HOME="$DARKBOT_TEST_DIR/app"; LOGDIR="$DARKBOT_TEST_DIR/logs"; RUNDIR="$DARKBOT_TEST_DIR/run"
  LABEL="com.darkbot.test.${DARKBOT_TEST_DIR##*.}.gateway"
  CAPTURE_LABEL="com.darkbot.test.${DARKBOT_TEST_DIR##*.}.capture"
  PLIST="$RUNDIR/gateway.plist"; CAPTURE_PLIST="$RUNDIR/capture.plist"
  PORT="${DARKBOT_TEST_PORT:?isolated port required}"
  case "$PORT" in ''|*[!0-9]*) exit 2;; esac
  [ "$PORT" -gt 1024 ] && [ "$PORT" -lt 65536 ] && [ "$PORT" != 8787 ] || exit 2
  URL="http://127.0.0.1:$PORT/"
  SOCK="$DARKBOT_TEST_DIR/p.sock"; GEN_FILE="$RUNDIR/p0.generation"; GEN_LOCK="$RUNDIR/p0.generation.lock"
  APP_CONF="$DARKBOT_TEST_DIR/app.conf"; ENV_FILES="$DARKBOT_TEST_DIR/capture.env"
  CAPTURE_BIN="$APP_HOME/current/p0-market-capture-reported"
  LOCKFILE="$RUNDIR/lifecycle.lock"; RESULT_FILE="$RUNDIR/capture.result"
  LAUNCH_FILE="$RUNDIR/capture.launch"; STOPPING_FILE="$RUNDIR/capture.stopping"; DOWN_FILE="$RUNDIR/lifecycle.down"
  USER_STOP_FILE="$RUNDIR/capture.user_stopped"
  export DARKBOT_NO_OPEN=1
fi
GEN_NEXT="${GEN_FILE%.*}.next"
# The deployed Project 0 controller; its project directory is the app's data home.
P0CTL_BIN="$APP_HOME/current/p0ctl"
# B03/U-9: the Project 0 analytics publisher (project0.analytics.jobs without a capture): its own
# socket and generation, the gateway's auxiliary `project0.analytics` feed, kept alive by launchd.
P0A_LABEL="${LABEL%.gateway}.p0.analytics"
P0A_PLIST="$RUNDIR/$P0A_LABEL.plist"
P0A_BIN="$APP_HOME/current/p0-analytics-reporter"
P0A_SOCK="/tmp/darkbot/project0-analytics.sock"
P0A_GEN_FILE="$HOME/.darkbot/p0-analytics.generation"
if [ -n "${DARKBOT_TEST_DIR:-}" ]; then
  P0A_SOCK="$DARKBOT_TEST_DIR/a.sock"; P0A_GEN_FILE="$RUNDIR/p0-analytics.generation"
fi
umask 077

mkdir -p "$APP_HOME/releases" "$LOGDIR" "$RUNDIR" "$(dirname "$SOCK")" "$(dirname "$PLIST")"
chmod 700 "$HOME/.darkbot" "$RUNDIR"

say() { printf '%s\n' "$*"; }
die() { printf 'darkbotctl: %s\n' "$*" >&2; exit 1; }

gateway_loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }
port_pid() { /usr/sbin/lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n1 || true; }
healthy() { /usr/bin/curl -fsS --max-time 2 "${URL}healthz" >/dev/null 2>&1; }

# Numeric setting from $APP_CONF (read, never sourced); second argument is the default.
app_conf() {
  local v=""
  if [ -f "$APP_CONF" ]; then v="$(sed -n "s/^$1=\([A-Za-z0-9_-][A-Za-z0-9_-]*\)$/\1/p" "$APP_CONF" | tail -n1)"; fi
  printf '%s' "${v:-${2:-}}"
}

# ---------------------------------------------------------------- lifecycle lock
# shlock(1) writes our PID and itself takes over a lock whose owner is dead. A live owner that
# is not darkbotctl (PID reuse) is reported and never stolen. Release only by the owner.
lock_holder() { cat "$LOCKFILE" 2>/dev/null || true; }
release_lock() { if [ "$(lock_holder)" = "$$" ]; then rm -f "$LOCKFILE"; fi; return 0; }
locked() {
  local i=0 holder cmd
  until /usr/bin/shlock -f "$LOCKFILE" -p $$; do
    holder="$(lock_holder)"
    cmd="$(ps -p "$holder" -o command= 2>/dev/null || true)"
    case "$cmd" in
      ''|*darkbotctl*) ;;
      *) die "Lock $LOCKFILE gehört PID $holder ($cmd), kein darkbotctl – nichts übernommen" ;;
    esac
    i=$((i+1))
    [ "$i" -lt 300 ] || die "eine andere DarkBot-Steuerung (PID $holder) hält den Lock seit über 30 s"
    [ $((i % 50)) -ne 0 ] || say "warte auf laufende DarkBot-Steuerung (PID $holder) …"
    sleep 0.1
  done
  trap release_lock EXIT
  "$@"
  release_lock
  trap - EXIT
}

# Shared controller helpers are installed alongside this script in each release.
if [ -f "$(dirname "${BASH_SOURCE[0]}")/bsc-control.sh" ]; then
  source "$(dirname "${BASH_SOURCE[0]}")/bsc-control.sh"
fi
# ---------------------------------------------------------------- capture identity (launchd)
capture_loaded() { launchctl list "$CAPTURE_LABEL" >/dev/null 2>&1; }
capture_pid() {
  launchctl list "$CAPTURE_LABEL" 2>/dev/null | sed -n 's/^[[:space:]]*"PID" = \([0-9][0-9]*\);$/\1/p' || true
}
capture_last_exit() {
  launchctl list "$CAPTURE_LABEL" 2>/dev/null \
    | sed -n 's/^[[:space:]]*"LastExitStatus" = \(-\{0,1\}[0-9][0-9]*\);$/\1/p' || true
}
capture_running() { [ -n "$(capture_pid)" ]; }
launch_id() { cat "$LAUNCH_FILE" 2>/dev/null || true; }
capture_stopping() { [ -n "$(capture_pid)" ] && [ "$(cat "$STOPPING_FILE" 2>/dev/null || true)" = "$(launch_id)" ]; }
assert_not_down() {
  [ -f "$DOWN_FILE" ] || return 0
  local owner; owner="$(cat "$DOWN_FILE")"
  if kill -0 "$owner" 2>/dev/null || capture_running; then
    die "Geordneter Gesamtstopp läuft – kein Start; ggf. down erneut ausführen"
  fi
  rm -f "$DOWN_FILE"
}
# A capture binary not owned by our launchd job (e.g. started by hand). Only ever used to refuse.
foreign_capture() {
  [ -z "${DARKBOT_TEST_DIR:-}" ] || return 0
  local p own; own="$(capture_pid)"
  for p in $(/usr/bin/pgrep -f 'p0-market-capture-reported$' 2>/dev/null || true); do
    if [ "$p" != "$own" ]; then echo "$p"; return 0; fi
  done
}

# After a crash only: remove reporter socket and generation lock that no live process holds.
clean_stale_reporter() {
  local f holders
  for f in "$SOCK" "$GEN_LOCK" "$GEN_NEXT"; do
    [ -e "$f" ] || continue
    holders="$(/usr/sbin/lsof -t -- "$f" 2>/dev/null | tr '\n' ' ' || true)"
    [ -z "$holders" ] || die "$f wird noch gehalten (PID $holders) – nichts entfernt"
    say "entferne verwaiste Datei nach Absturz: $f"
    rm -f -- "$f"
  done
}

# ---------------------------------------------------------------- run result
result_field() {
  [ -f "$RESULT_FILE" ] || return 0
  sed -n "s/^$1=\([A-Za-z0-9_.-]*\)$/\1/p" "$RESULT_FILE" | tail -n1
}
last_result_line() {
  if [ -f "$RESULT_FILE" ] && [ "$(result_field launch_id)" = "$(launch_id)" ]; then printf 'run=%s code=%s' "$(result_field run_id)" "$(result_field code)"
  else printf 'kein Ergebnis'; fi
}
# Cooldown only if the run THIS tool launched last ended without a market stream.
recent_provider_failure() {
  local ended cooldown
  [ -f "$RESULT_FILE" ] && [ -f "$LAUNCH_FILE" ] || return 1
  [ "$(result_field launch_id)" = "$(cat "$LAUNCH_FILE")" ] || return 1
  [ "$(result_field code)" = "MARKET_OBSERVER_STREAM_NOT_READY" ] || return 1
  ended="$(result_field ended_unix_s)"
  [ -n "$ended" ] || return 1
  cooldown=600
  [ $(( $(date +%s) - ended )) -lt "$cooldown" ]
}

# ---------------------------------------------------------------- launchd definitions
write_plist() {
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$(printf '%s' "$APP_HOME/current/darkbot-gateway" | xml_escape)</string></array>
  <key>WorkingDirectory</key><string>$(printf '%s' "$APP_HOME/current" | xml_escape)</string>
  <key>EnvironmentVariables</key>
  <dict>
    $(plist_env DARKBOT_GATEWAY_STATIC_DIR "$APP_HOME/current/dist")
$(plist_env DARKBOT_GATEWAY_BIND "127.0.0.1:$PORT")
$(plist_env DARKBOT_GATEWAY_GENERATION_FILE "$RUNDIR/gateway.generation")
    $(plist_env DARKBOT_GATEWAY_FEEDS "project0=$SOCK,project0.analytics=$P0A_SOCK,bsc=$BSC_SOCKET")
$(plist_env DARKBOT_CTL "$APP_HOME/current/darkbotctl")
$(plist_env DARKBOT_RUNDIR "$RUNDIR")
$(plist_env DARKBOT_LOGDIR "$LOGDIR")
$(plist_env DARKBOT_CAPTURE_LABEL "$CAPTURE_LABEL")
$(plist_env DARKBOT_APP_CONF "$APP_CONF")
$(if [ -n "${DARKBOT_TEST_DIR:-}" ]; then plist_env DARKBOT_TEST_DIR "$DARKBOT_TEST_DIR"; plist_env DARKBOT_TEST_PORT "$PORT"; fi)
    <key>RUST_LOG</key><string>info</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>$(printf '%s' "$LOGDIR/gateway.log" | xml_escape)</string>
  <key>StandardErrorPath</key><string>$(printf '%s' "$LOGDIR/gateway.log" | xml_escape)</string>
</dict>
</plist>
EOF
}

xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
plist_env() { printf '    <key>%s</key><string>%s</string>\n' "$1" "$(printf '%s' "$2" | xml_escape)"; }

# One definition per run: duration, log, result and launch id; never KeepAlive, never at login.
write_capture_plist() {
  local secs="$1" log="$2" launch="$3" k extra=""
  # A launchd job does not inherit this shell: forward the few per-run overrides explicitly.
  for k in P0_WS_URL P0_MARKET_READY_TIMEOUT_SECS P0_REPORT_MIN_INTERVAL_MS; do
    if [ -n "${!k:-}" ]; then extra="$extra$(plist_env "$k" "${!k}")"$'\n'; fi
  done
  ( umask 077; cat > "$CAPTURE_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$CAPTURE_LABEL</string>
  <key>ProgramArguments</key><array><string>$(printf '%s' "$CAPTURE_BIN" | xml_escape)</string></array>
  <key>WorkingDirectory</key><string>$(printf '%s' "$APP_HOME/current" | xml_escape)</string>
  <key>EnvironmentVariables</key>
  <dict>
$(plist_env P0_CAPTURE_BIN "$CAPTURE_BIN")
$(plist_env P0_ENV_FILE "$ENV_FILES")
$(plist_env P0_MARKET_OUT_DIR "$APP_HOME/data/market")
$(plist_env P0_REPORT_SOCKET "$SOCK")
$(plist_env P0_REPORT_GENERATION_FILE "$GEN_FILE")
$(plist_env P0_MARKET_RUN_ID "app-$launch")
$(plist_env P0_MARKET_DURATION_SECS "$secs")
$(plist_env P0_RESULT_FILE "$RESULT_FILE")
$(plist_env P0_LAUNCH_ID "$launch")
$extra  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ExitTimeOut</key><integer>$STOP_BUDGET_S</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$(printf '%s' "$log" | xml_escape)</string>
  <key>StandardErrorPath</key><string>$(printf '%s' "$log" | xml_escape)</string>
</dict>
</plist>
EOF
  )
}

p0_analytics_up() {
  [ -x "$P0A_BIN" ] || return 0
  if launchctl list "$P0A_LABEL" >/dev/null 2>&1; then return 0; fi
  ( umask 077; cat > "$P0A_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$P0A_LABEL</string>
  <key>ProgramArguments</key><array><string>$(printf '%s' "$P0A_BIN" | xml_escape)</string></array>
  <key>WorkingDirectory</key><string>$(printf '%s' "$APP_HOME/current" | xml_escape)</string>
  <key>EnvironmentVariables</key>
  <dict>
$(plist_env P0_REPORT_SOCKET "$P0A_SOCK")
$(plist_env P0_REPORT_GENERATION_FILE "$P0A_GEN_FILE")
$(plist_env P0_REPORT_ANALYTICS_PROJECT_DIR "$APP_HOME")
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>$(printf '%s' "$LOGDIR/p0-analytics.log" | xml_escape)</string>
  <key>StandardErrorPath</key><string>$(printf '%s' "$LOGDIR/p0-analytics.log" | xml_escape)</string>
</dict>
</plist>
EOF
  )
  launchctl bootstrap "$DOMAIN" "$P0A_PLIST"
}

# ---------------------------------------------------------------- build / deploy / window
stage_capture_env() {
  [ -z "${DARKBOT_TEST_DIR:-}" ] || return 0
  [ -f "$ROOT/project_0/.env" ] || die "project_0/.env fehlt"
  cp "$ROOT/project_0/config/market.public.env" "$RUNDIR/capture.public.env"
  cp "$ROOT/project_0/.env" "$RUNDIR/capture.private.env"
  chmod 600 "$RUNDIR/capture.public.env" "$RUNDIR/capture.private.env"
}

cmd_build() {
  rm -f "$ROOT/gateway/target/darkbot-release.json"
  command -v npm >/dev/null || die "npm nicht im PATH – im Terminal ausführen"
  command -v cargo >/dev/null || die "cargo nicht im PATH – im Terminal ausführen"
  (cd "$ROOT/frontend" && npm run lint && npm run lint:boundaries && npm run lint:css && npm run check:freeze && npm run build)
  (cd "$ROOT/gateway" && cargo build --release --locked --offline)
  (cd "$ROOT/project_0/native" && cargo build --release --locked --offline -p darkbot-p0-reporter --bin p0-market-capture-reported --bin p0-analytics-reporter && cargo build --release --locked --offline -p darkbot-runner --bin p0ctl)
  (cd "$ROOT/bsc/engine" && cargo build --release --locked --offline -p darkbot-bsc-qualification --features status-reporter --bin bsc-status-reporter && cargo build --release --locked --offline -p darkbot-bsc-execution --features g07-mainnet --bin g07_pre_live_readiness --bin g07_candidate)
  /usr/bin/python3 "$ROOT/ops/release_manifest.py" --write
  say "build ok – weiter mit: darkbotctl deploy"
}

cmd_deploy() {
  /usr/bin/python3 "$ROOT/ops/release_manifest.py" || die "Kein kohärenter Release-Build"
  [ -x "$GATEWAY_BUILD" ] || die "Gateway nicht gebaut: darkbotctl build"
  [ -f "$DIST_BUILD/index.html" ] || die "Frontend nicht gebaut: darkbotctl build"
  [ -x "$CAPTURE_BUILD" ] || die "Capture nicht gebaut: darkbotctl build"
  [ -x "$P0CTL_BUILD" ] || die "p0ctl nicht gebaut: darkbotctl build"
  [ -x "$P0A_BUILD" ] || die "p0-analytics-reporter nicht gebaut: darkbotctl build"
  if capture_running && [ -f "$APP_HOME/current/SCHEMA_ID" ] && ! cmp -s "$ROOT/protocol/schema_id.txt" "$APP_HOME/current/SCHEMA_ID"; then
    die "Schema geändert: Capture zuerst geordnet stoppen; Deploy und Neustart gemeinsam durchführen"
  fi
  if capture_running && [ ! -f "$APP_HOME/current/SCHEMA_ID" ]; then die "Alter Release ohne Schema-Nachweis: vor Deploy Capture geordnet stoppen"; fi
  [ -z "$(bsc_pid)" ] || die "Readiness läuft; Deploy erst nach Abschluss"
  [ -x "$ROOT/bsc/engine/target/release/bsc-status-reporter" ] || die "BSC Reporter nicht gebaut"
  [ -x "$ROOT/bsc/engine/target/release/g07_pre_live_readiness" ] || die "BSC Readiness nicht gebaut"
  [ -x "$ROOT/bsc/engine/target/release/g07_candidate" ] || die "BSC Kandidatenverwaltung nicht gebaut"
  bsc_sync
  local rel; rel="$APP_HOME/releases/$(date +%Y%m%dT%H%M%S)"
  mkdir -p "$rel"
  cp "$GATEWAY_BUILD" "$rel/darkbot-gateway"
  cp "$CAPTURE_BUILD" "$rel/p0-market-capture-reported"
  cp "$P0CTL_BUILD" "$rel/p0ctl"
  cp "$P0A_BUILD" "$rel/p0-analytics-reporter"
  cp "$ROOT/ops/darkbotctl" "$rel/darkbotctl"
  cp "$ROOT/ops/bsc-control.sh" "$rel/bsc-control.sh"
  cp "$ROOT/bsc/engine/target/release/bsc-status-reporter" "$ROOT/bsc/engine/target/release/g07_pre_live_readiness" "$ROOT/bsc/engine/target/release/g07_candidate" "$rel/"
  cp "$ROOT/protocol/schema_id.txt" "$rel/SCHEMA_ID"
  ln -s "$APP_HOME/bsc-source" "$rel/bsc-root"
  chmod 755 "$rel/darkbotctl"
  stage_capture_env
  cp -R "$DIST_BUILD" "$rel/dist"
  git -C "$ROOT" rev-parse HEAD > "$rel/COMMIT" 2>/dev/null || echo unknown > "$rel/COMMIT"
  ln -s "$rel" "$APP_HOME/.current-$$"
  mv -fh "$APP_HOME/.current-$$" "$APP_HOME/current"
  if launchctl list "$BSC_REPORTER_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$DOMAIN/$BSC_REPORTER_LABEL"
    bsc_reporter_up
  fi
  if launchctl list "$P0A_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$DOMAIN/$P0A_LABEL"
    p0_analytics_up
  fi
  # Previous releases stay; a running capture keeps executing the binary it was started from.
  say "deployed $(cat "$rel/COMMIT")"
  if gateway_loaded; then _reload_gateway; fi
  if capture_running; then say "laufende Capture nutzt bis zu ihrem Ende den vorherigen Release"; fi
}

cmd_open() {
  if [ -n "${DARKBOT_NO_OPEN:-}" ]; then say "Fenster nicht geöffnet (DARKBOT_NO_OPEN)"; return 0; fi
  if [ -d "/Applications/Google Chrome.app" ]; then
    # Eigenes Fenster ohne Tabs/Adressleiste, eigenes Profil (kollidiert nicht mit deinem Chrome)
    open -na "Google Chrome" --args --app="$URL" --user-data-dir="$HOME/.darkbot/chrome-profile" --no-first-run
  else
    open "$URL"
  fi
}

# ---------------------------------------------------------------- gateway
cmd_up_inner() {
  assert_not_down
  [ -x "$APP_HOME/current/darkbot-gateway" ] || die "nicht deployed: darkbotctl build && darkbotctl deploy"
  local p; p="$(port_pid)"
  if [ -n "$p" ] && ! gateway_loaded; then
    die "Port $PORT gehört keinem verwalteten Gateway (PID $p); kein fremder Prozess wird beendet"
  fi
  if ! gateway_loaded; then
    write_plist
    launchctl bootstrap "$DOMAIN" "$PLIST"
  fi
  bsc_reporter_up
  p0_analytics_up
  local i=0; until healthy || [ $i -ge 50 ]; do sleep 0.2; i=$((i+1)); done
  healthy || die "Gateway antwortet nicht – siehe $LOGDIR/gateway.log"
  say "gateway: $(/usr/bin/curl -fsS "${URL}healthz")"
  if [ "${1:-}" != "--no-open" ]; then cmd_open; fi
}
cmd_up() { locked cmd_up_inner "${1:-}"; }

_restart_gateway() {
  assert_not_down
  gateway_loaded || die "Gateway läuft nicht: darkbotctl up"
  launchctl kickstart -k "$DOMAIN/$LABEL"
  say "Gateway neu gestartet (Capture unberührt, Reporter verbindet neu)"
}

_gateway_down() {
  if gateway_loaded; then
    launchctl bootout "$DOMAIN/$LABEL" || true
    rm -f "$PLIST"
    say "Gateway gestoppt"
  else
    say "Gateway lief nicht"
  fi
}

# ---------------------------------------------------------------- project 0 controller
# B03/U-9, S1-02: the GUI's analytics jobs and source modes run the deployed p0ctl (the same
# `p0ctl job|source` a terminal runs) on the app's data home; a started job's worker outlives this call.
cmd_p0() {
  case "${1:-}" in job|source) ;; *) die "p0 job start|cancel|status … | p0 source set UNIT MODE | p0 source status" ;; esac
  [ -x "$P0CTL_BIN" ] || die "p0ctl nicht deployed: darkbotctl build && darkbotctl deploy"
  P0_PROJECT_DIR="$APP_HOME" exec "$P0CTL_BIN" "$@"
}

# ---------------------------------------------------------------- capture
_capture_start() {
  assert_not_down
  local secs="${1:-}" log launch p foreign i=0 previous_generation
  previous_generation="$(cat "$GEN_FILE" 2>/dev/null || echo 0)"
  case "$secs" in until-stopped) ;; ''|*[!0-9]*) die "Dauer in Sekunden angeben, z. B. darkbotctl capture start 600 (keine Standarddauer)";; esac
  if [ "$secs" != until-stopped ]; then
    [ "$secs" -ge 60 ] && [ "$secs" -le 86400 ] || die "Dauer: until-stopped oder 60..86400 Sekunden"
  fi
  if capture_running; then
    if capture_stopping; then say "Capture beendet sich gerade (pid $(capture_pid)) – kein neuer Start"
    else say "Capture läuft bereits (pid $(capture_pid))"; fi
    return 0
  fi
  foreign="$(foreign_capture)"
  [ -z "$foreign" ] || die "Capture-Prozess $foreign läuft außerhalb von launchd – kein zweiter Start (Stopp: kill -TERM $foreign)"
  [ -x "$CAPTURE_BIN" ] || die "Capture nicht deployed: darkbotctl build && darkbotctl deploy"
  if [ -z "${DARKBOT_TEST_DIR:-}" ]; then
    # The deployed controller never needs access to the privacy-protected Desktop checkout.
    if [ "${DARKBOT_STAGED:-}" != 1 ]; then stage_capture_env; fi
    [ -f "$RUNDIR/capture.public.env" ] && [ -f "$RUNDIR/capture.private.env" ] || die "Capture-Konfiguration nicht bereitgestellt: darkbotctl deploy"
    ENV_FILES="$RUNDIR/capture.public.env:$RUNDIR/capture.private.env"
  fi
  mkdir -p "$APP_HOME/data/market"
  clean_stale_reporter
  # Not running (checked above, under the lock): unloading the finished job cannot hit a live run.
  if capture_loaded; then launchctl bootout "$DOMAIN/$CAPTURE_LABEL" 2>/dev/null || true; fi
  log="$LOGDIR/capture-$(date +%Y%m%dT%H%M%S)-$$.log"
  launch="$(/usr/bin/uuidgen | tr '[:upper:]' '[:lower:]')"
  write_capture_plist "$secs" "$log" "$launch"
  rm -f "$STOPPING_FILE" "$RUNDIR/capture.pid"
  printf '%s\n' "$launch" > "$LAUNCH_FILE"
  launchctl bootstrap "$DOMAIN" "$CAPTURE_PLIST" || die "launchd hat die Capture nicht angenommen. Log: $log"
  # A launchd PID alone may still be starting or already failing. Require the new reporter epoch.
  until [ -S "$SOCK" ] && [ "$(cat "$GEN_FILE" 2>/dev/null || echo 0)" != "$previous_generation" ] && capture_running; do
    i=$((i+1))
    [ "$i" -lt 100 ] || die "Reporter nicht bereit (Exit $(capture_last_exit)). Log: $log"
    if [ -f "$RESULT_FILE" ] && [ "$(result_field launch_id)" = "$launch" ]; then
      die "Capture beim Start beendet: $(result_field code). Log: $log"
    fi
    sleep 0.1
  done
  p="$(capture_pid)"
  nohup /usr/bin/caffeinate -i -w "$p" >/dev/null 2>&1 &
  ln -sfn "$log" "$LOGDIR/capture-latest.log"
  say "Capture gestartet pid=$p dauer=$secs launch=$launch"
}


# A deliberate Stop is sticky even if the capture is already absent.
# Call only while holding lifecycle.lock. Publish atomically (umask 077).
_suspend_autostart() {
  local tmp="$USER_STOP_FILE.$$"
  printf 'launch=%s stopped_unix_s=%s\n' "$(launch_id)" "$(date +%s)" > "$tmp"
  mv -f "$tmp" "$USER_STOP_FILE"
}

# Never clear user intent on a no-op (already running or sealing) or failed start.
# The new launch ID is insufficient alone: _capture_start must have returned successfully,
# and launchd must still report the new, non-stopping capture.
_capture_start_explicit() {
  local before after
  before="$(launch_id)"
  _capture_start "$@"
  after="$(launch_id)"
  if [ -n "$after" ] && [ "$after" != "$before" ] && capture_running && ! capture_stopping; then
    rm -f "$USER_STOP_FILE"
  fi
}

_capture_start_configured() {
  local secs; secs="$(app_conf P0_APP_CAPTURE_SECS)"
  [ -n "$secs" ] || die "P0_APP_CAPTURE_SECS nicht konfiguriert"
  _capture_start_explicit "$secs"
}

# Under the lock only the signal is sent; draining is awaited without holding it.
_capture_stop_signal() {
  local p; p="$(capture_pid)"
  if [ -z "$p" ]; then say "keine Capture aktiv"; return 0; fi
  STOP_LAUNCH="$(launch_id)"; STOP_PID="$p"
  printf '%s\n' "$STOP_LAUNCH" > "$STOPPING_FILE"
  say "Capture pid $p: geordneter Stopp (SIGTERM) – Drain und Versiegelung, bis zu ${STOP_BUDGET_S}s"
  launchctl kill SIGTERM "$DOMAIN/$CAPTURE_LABEL" || { [ "$(capture_pid)" != "$STOP_PID" ] || die "Capture konnte nicht signalisiert werden"; }
  STOP_SENT=1
}
capture_wait_stopped() {
  local i=0
  while [ "$(launch_id)" = "$STOP_LAUNCH" ] && [ "$(capture_pid)" = "$STOP_PID" ]; do
    sleep 1; i=$((i+1))
    if [ $((i % 15)) -eq 0 ]; then say "  Drain/Finalisierung läuft … ${i}s"; fi
    if [ "$i" -ge "$STOP_BUDGET_S" ]; then
      die "Capture nach ${STOP_BUDGET_S}s nicht beendet – wird NICHT gekillt (Journal). Prüfen: darkbotctl logs capture"
    fi
  done
  locked _clear_stopping
  say "Capture beendet (Exit $(capture_last_exit)) · $(last_result_line)"
}
_clear_stopping() {
  if [ "$(cat "$STOPPING_FILE" 2>/dev/null || true)" = "$STOP_LAUNCH" ]; then rm -f "$STOPPING_FILE"; fi
}
_capture_stop_request() {
  _suspend_autostart
  _capture_stop_signal
  bsc_readiness_stop
}
cmd_capture_stop() {
  locked _capture_stop_request
  if [ "$STOP_SENT" -eq 1 ]; then capture_wait_stopped; fi
  return 0
}

cmd_capture_status() {
  local p f; p="$(capture_pid)"; f="$(foreign_capture)"
  if [ -n "$p" ]; then
    if capture_stopping; then say "capture: beendet sich (pid $p)"; else say "capture: läuft (pid $p, launchd)"; fi
  else
    say "capture: läuft nicht · letzter Lauf: $(last_result_line)"
  fi
  [ -z "$f" ] || say "WARNUNG: Capture-Prozess $f läuft außerhalb von launchd; Stopp: kill -TERM $f"
  if [ -e "$LOGDIR/capture-latest.log" ]; then tail -n 3 "$LOGDIR/capture-latest.log"; fi
}

# ---------------------------------------------------------------- one click
app_inner() {
  local auto secs
  say "[1/3] Gateway"
  cmd_up_inner --no-open
  say "[2/3] Project_0 Read-only-Capture"
  if capture_running; then
    if capture_stopping; then say "Capture beendet sich gerade – kein neuer Start"
    else say "Capture läuft (pid $(capture_pid))"; fi
  else
    auto="$(app_conf P0_APP_AUTOSTART_CAPTURE 0)"
    secs="$(app_conf P0_APP_CAPTURE_SECS)"
    if [ "$auto" != 1 ] || [ -z "$secs" ]; then
      say "AUTOSTART_OFF: keine automatische Beobachtung konfiguriert (P0_APP_AUTOSTART_CAPTURE=1 und P0_APP_CAPTURE_SECS in $APP_CONF)"
    elif [ -f "$USER_STOP_FILE" ]; then
      say "AUTOSTART_SUSPENDED: Manueller Capture-Stopp aktiv; Neustart nur mit darkbotctl capture start <dauer>"
    elif recent_provider_failure; then
      say "PROVIDER_COOLDOWN: letzter Lauf endete ohne Marktstream – kein automatischer Neustart vor Ablauf der Sperre"
    else
      ( trap - EXIT; _capture_start "$secs" ) || say "CAPTURE_START_FAILED – Cockpit öffnet trotzdem (darkbotctl logs capture)"
    fi
  fi
  say "[3/3] Cockpit"
  cmd_open
}
cmd_app() { locked app_inner; }

_down_begin() {
  local owner
  owner="$(cat "$DOWN_FILE" 2>/dev/null || true)"
  if [ -n "$owner" ] && [ "$owner" != "$$" ] && kill -0 "$owner" 2>/dev/null; then
    die "Gesamtstopp läuft bereits (PID $owner)"
  fi
  printf '%s\n' "$$" > "$DOWN_FILE"
  _suspend_autostart
  _capture_stop_signal
  bsc_readiness_stop
}
_down_finish() {
  [ "$(cat "$DOWN_FILE" 2>/dev/null || true)" = "$$" ] || die "Stopp-Zuordnung geändert"
  capture_running && die "Capture noch aktiv; Gateway bleibt an"
  [ -z "$(bsc_pid)" ] || die "BSC Readiness stoppt noch; Gateway bleibt aktiv"
  launchctl bootout "$DOMAIN/$BSC_REPORTER_LABEL" >/dev/null 2>&1 || true
  launchctl bootout "$DOMAIN/$P0A_LABEL" >/dev/null 2>&1 || true
  _gateway_down
  rm -f "$DOWN_FILE"
}
cmd_down() {
  locked _down_begin
  if [ "$STOP_SENT" -eq 1 ]; then capture_wait_stopped; fi
  bsc_wait_stopped
  locked _down_finish
}

# ---------------------------------------------------------------- status
cmd_status() {
  if gateway_loaded; then say "gateway: läuft (launchd)"; else say "gateway: gestoppt"; fi
  local p; p="$(port_pid)"
  if [ -n "$p" ]; then say "port 8787: pid $p ($(basename "$(ps -p "$p" -o comm=)"))"; fi
  if healthy; then say "healthz: $(/usr/bin/curl -fsS "${URL}healthz")"; fi
  if [ -S "$SOCK" ]; then say "reporter-socket: vorhanden"; else say "reporter-socket: fehlt"; fi
  cmd_capture_status
  if [ -e "$APP_HOME/current/COMMIT" ]; then say "deployed commit: $(cat "$APP_HOME/current/COMMIT")"; fi
}

cmd_logs() {
  case "${1:-gateway}" in
    gateway) tail -n 200 -f "$LOGDIR/gateway.log" ;;
    capture) tail -n 200 -f "$LOGDIR/capture-latest.log" ;;
    *) die "logs gateway|capture" ;;
  esac
}

_reload_gateway() {
  assert_not_down
  if gateway_loaded; then launchctl bootout "$DOMAIN/$LABEL"; fi
  write_plist
  launchctl bootstrap "$DOMAIN" "$PLIST"
  cmd_up_inner --no-open
}

cmd_is_up() { gateway_loaded; }
cmd_is_healthy() { gateway_loaded && healthy; }

cmd_status_short() {
  local g c
  if cmd_is_healthy; then g="Gateway läuft"; elif gateway_loaded; then g="Gateway antwortet nicht"; else g="Gateway gestoppt"; fi
  if capture_stopping; then c="Capture beendet sich"; elif capture_running; then c="Capture läuft"; else c="keine Capture"; fi
  if [ -f "$USER_STOP_FILE" ] && ! capture_running; then c="$c (Autostart pausiert: manueller Stopp)"; fi
  printf '%s · %s · Aufnahme: %s\n' "$g" "$c" "$(app_conf P0_APP_CAPTURE_SECS nicht-konfiguriert)"
}

# ---------------------------------------------------------------- desktop app
make_icns() {
  local png="$1" dest="$2" temp iconset n
  temp="$(mktemp -d)"
  iconset="$temp/DarkBot.iconset"
  mkdir -p "$iconset"
  for n in 16 32 128 256 512; do
    /usr/bin/sips -s format png -z "$n" "$n" "$png" --out "$iconset/icon_${n}x${n}.png" >/dev/null
    /usr/bin/sips -s format png -z "$((n*2))" "$((n*2))" "$png" --out "$iconset/icon_${n}x${n}@2x.png" >/dev/null
  done
  /usr/bin/iconutil -c icns "$iconset" -o "$dest"
  rm -rf "$temp"
}

cmd_install_apps() {
  local app="$HOME/Desktop/DarkBot.app" ctl="$ROOT/ops/darkbotctl"
  local tmp src compiled backup
  tmp="$(mktemp -d)"
  src="$tmp/DarkBot.applescript"
  compiled="$tmp/DarkBot.app"
  backup="$HOME/Desktop/.DarkBot.previous.$$"
  mkdir -p "$HOME/Desktop"
  cat > "$src" <<EOF
set ctl to quoted form of "$ctl"
set logf to quoted form of "$LOGDIR/app.log"
-- Desktop opening owns only gateway availability and the cockpit window.
-- Capture Start/Stop is explicit in the dashboard; reopening never signals it.
set runApp to ctl & " up >> " & logf & " 2>&1 || { tail -n 5 " & logf & " >&2; exit 1; }"
try
	with timeout of 120 seconds
		do shell script runApp
	end timeout
on error errMsg number errNum
	if errNum is -128 then return
	display dialog ("DarkBot:" & return & errMsg & return & return & "Details: ~/Library/Logs/DarkBot/app.log") buttons {"OK"} default button "OK" with title "DarkBot" with icon stop
end try
EOF
  if ! /usr/bin/osacompile -o "$compiled" "$src"; then
    rm -rf "$tmp"; die "AppleScript-Kompilierung fehlgeschlagen; alte App bleibt erhalten"
  fi
  if [ -f "$ROOT/ops/assets/DarkBot.png" ]; then
    cp "$ROOT/ops/assets/DarkBot.png" "$tmp/DarkBot.png"
  else
    command -v swift >/dev/null 2>&1 || die "Swift fehlt"
    if ! swift "$ROOT/ops/assets/make_icon.swift" "$tmp/DarkBot.png"; then
      rm -rf "$tmp"; die "Icon-Generierung fehlgeschlagen"
    fi
  fi
  if ! make_icns "$tmp/DarkBot.png" "$compiled/Contents/Resources/applet.icns"; then
    rm -rf "$tmp"; die "Icon-Konvertierung fehlgeschlagen"
  fi
  rm -f "$compiled/Contents/Resources/Assets.car"
  /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$compiled/Contents/Info.plist" >/dev/null 2>&1 || true
  /usr/libexec/PlistBuddy -c "Set :CFBundleIconFile applet" "$compiled/Contents/Info.plist" >/dev/null 2>&1 ||
    /usr/libexec/PlistBuddy -c "Add :CFBundleIconFile string applet" "$compiled/Contents/Info.plist"
  if ! /usr/bin/codesign --force --sign - "$compiled"; then
    rm -rf "$tmp"; die "Codesign fehlgeschlagen; alte App bleibt erhalten"
  fi
  if [ -e "$app" ] || [ -L "$app" ]; then mv "$app" "$backup"; fi
  if mv "$compiled" "$app"; then
    rm -rf "$backup"
  else
    if [ -e "$backup" ] || [ -L "$backup" ]; then mv "$backup" "$app"; fi
    rm -rf "$tmp"; die "Installation fehlgeschlagen"
  fi
  rm -rf "$tmp"
  touch "$app"
  say "Ein Symbol: $app"
}

case "${1:-status}" in
  bsc) shift; cmd_bsc "$@" ;;
  p0) shift; cmd_p0 "$@" ;;
  build) cmd_build ;;
  deploy) locked cmd_deploy ;;
  app) cmd_app ;;
  up) shift; cmd_up "${1:-}" ;;
  down) cmd_down ;;
  restart-gateway) locked _restart_gateway ;;
  reload-gateway) locked _reload_gateway ;;
  status) cmd_status ;;
  open) cmd_open ;;
  logs) shift; cmd_logs "${1:-gateway}" ;;
  capture)
    shift
    case "${1:-status}" in
      start) shift; locked _capture_start_explicit "${1:-}" ;;
      start-configured) locked _capture_start_configured ;;
      stop) shift; if [ "${1:-}" = "--signal-only" ]; then locked _capture_stop_request; else cmd_capture_stop; fi ;;
      status) cmd_capture_status ;;
      *) die "capture start <sekunden> | stop | status" ;;
    esac ;;
  is-capturing) capture_running ;;
  is-up) cmd_is_up ;;
  is-healthy) cmd_is_healthy ;;
  status-short) cmd_status_short ;;
  install-apps) cmd_install_apps ;;
  *) die "unbekannt: $1 (build|deploy|app|up|down|restart-gateway|status|open|logs|capture|p0|install-apps)" ;;
esac
