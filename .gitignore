# Code, JSON configuration, fixtures and report exports are versioned by default.
# From the repository root, use git add . to stage all non-ignored changes.
# Do not blanket-unignore exports: the exclusions below also apply there.

# macOS
.DS_Store
._*

# Python caches and test output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Secrets / environment (keep the sanitized example)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime databases and SQLite sidecars
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db-wal
*.db-shm
*.db-journal

# Runtime logs and failed writer batches (may contain raw recording data)
*.log
*.quarantine.jsonl

# IDE
.idea/
.vscode/

# No blanket exclusions for data/ or exports/:
# evidence JSON, reports, CSV, Markdown and ZIP exports remain eligible for Git.

# JavaScript dependency trees are reproducible from package-lock files
node_modules/
