# Project_0 local runtime data protection.
# Narrow, path-anchored rules only. The repository-root .gitignore still applies
# (.env, *.log, SQLite, **/target/, key and secret material) and is not repeated here.
# Versioned evidence belongs in docs/evidence/ and is not affected by this file.

# Run and capture output at the default locations used by the runtime and launchers.
# econ.rs P0_ECON_OUT_DIR; scripts/capture.sh (P0_RUN_STORE=legacy); scripts/smoke.sh
/data/econ4h/
# market_observer.rs P0_MARKET_OUT_DIR; scripts/capture.sh market
/data/market/
# main.rs P0_RECORD_PATH, P0_SUMMARY_PATH, P0_MT0_PATH; scripts/capture.sh shadow and econ4h
/data/shadow/
# operations/capture/c0_census.py --out default
/data/c0/
# Default run store for new econ4h runs, layout V2 (operations/capture/run_store.py)
/data/runs/
# Runtime-owner lock: orchestration/control.rs (P0_RUNTIME_LOCK default), scripts/capture.sh, p0ctl
/data/.p0-runtime.lock
# Reconstructible caches and working data (docs/operations/data_policy.md); scripts/smoke.sh
/data/cache/

# Local integration results kept outside docs/evidence/; never versioned.
/evidence/C0_E1_local_integration_20261008/

# Local shell environment file with private settings. The root rule env/ matches directories only.
/env
# P0-026: runtime state the owner, p0ctl and the boot controller keep under the project. The boot
# audit binds `git status --porcelain` (BOOT-01), so this state must never change the identity.
# orchestration/boot_control.rs BOOT_DIR
/data/boot/
# orchestration/provider_evidence.rs STORE
/data/provider_evidence/
# orchestration/provider_registry.rs STORE (DEC-18; no secret: credentials live in the keychain)
/data/providers/
# DEC-18 §3/§2 (C-11, C-01): the provider pre-measurements and the deployment reads (plans,
# records, bytecode).
/data/provider_measure/
/data/c01/
# DEC-17a: the registered operator key (its Secure-Enclave-wrapped form, usable on this Mac only).
/data/operator/
# DEC-17e: archived corrupt journals with their manifests.
/data/archive/
# orchestration/until_stopped.rs STORE (qualifications, autostart)
/data/until_stopped/
# orchestration/fe06.rs STORE
/data/fe06/
# orchestration/capability_control.rs, source_control.rs request_dir
/data/capability-control/
/data/source-control/
# analytics/jobs.rs JOB_DIR, analytics/h0.rs output_dir, analytics/backtest.rs PROFILE_DIR
/data/analytics-jobs/
/data/h0/
/data/profiles/
# execution/fee_parity.rs seal_dir
/data/fee-parity/
