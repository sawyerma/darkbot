# Project_0 local secrets/configuration template.
# Copy to project_0/.env, fill locally, then chmod 600 project_0/.env.
# NEVER commit project_0/.env.

# DEC-18: RPC/WSS providers are the provider registry's (`p0ctl provider add`, `select`), their
# API keys the macOS keychain's (`p0ctl provider credential set`, hidden input). A key kept here
# only for the one-time controlled import (`p0ctl provider credential import-env --variable
# HELIUS_API_KEY`); no runtime path derives an endpoint from it, and an endpoint URL carrying a
# key is refused. Remove it once imported (the launch scripts still load this file).
HELIUS_API_KEY=

# Only a loopback endpoint (a local node, an offline test) may be named here:
# P0_RPC_URL=http://127.0.0.1:8899
# P0_WS_URL=ws://127.0.0.1:8900

# Absolute path to the dedicated Project_0 Solana keypair OUTSIDE this repository.
P0_KEYPAIR_PATH=

# Required execution guardrail.
P0_MAX_SLIPPAGE_BPS=
