# DarkBot Phase-1 local endpoints / credentials
# Copy this file to .env and enter private credentials there.
# NEVER commit .env.

# Helius Standard
HELIUS_API_KEY=

# Independent / fallback Solana RPC
EXISTING_RPC_WSS_URL=wss://api.mainnet-beta.solana.com/
EXISTING_RPC_HTTP_URL=https://api.mainnet-beta.solana.com

# Optional PumpPortal hints
PUMPPORTAL_API_KEY=
