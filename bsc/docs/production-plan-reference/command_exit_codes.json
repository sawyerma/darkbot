{
  "lock": {
    "command": [
      "cargo",
      "generate-lockfile",
      "--offline"
    ],
    "exit_code": 0
  },
  "original_fmt": {
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 1
  },
  "debug_test": {
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  "release_test": {
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--release",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  "clippy": {
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--locked",
      "--offline",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  "toolchain": {
    "command": [
      "rustc",
      "--version",
      "--verbose"
    ],
    "exit_code": 0
  },
  "cargo_version": {
    "command": [
      "cargo",
      "--version"
    ],
    "exit_code": 0
  },
  "format": {
    "command": [
      "cargo",
      "fmt",
      "--all"
    ],
    "exit_code": 0
  },
  "final_fmt": {
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0
  }
}