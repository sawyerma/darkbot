# GUI readiness (read-only, BSC-050 A-scan): public operator configuration,
# copied into each snapshot by `darkbotctl bsc sync`. No secret here; a keyed
# endpoint belongs in the operator's own environment for the CLI readiness.
# The read-only RPC endpoint the GUI readiness evaluates the current chain on.
BSC_READINESS_RPC_HTTPS=https://bsc-dataseed.bnbchain.org
# The clock the G0.7 capture measures with (Rust std Instant on macOS).
DARKBOT_G07_CLOCK_ID=macos.CLOCK_UPTIME_RAW
