# REV.1.0 R2: the LIVE qualification campaign manifest (master plan §13 J "Frozen qualification campaign").
# `bsc_runtime live attempts --manifest` rates nothing (CAMPAIGN_NOT_READY) until every value below is filled,
# BSC_CAMPAIGN_STATE=REVIEWED, every campaign run is of the named build, configuration and host, every attempt
# went through the named builders from the named sources, and `bsc_runtime live campaign-precommit` committed
# this file's hash before the campaign's attempts. Cells, sample sizes, durations and limits are the operator's
# reviewed decision; this file does not invent them. This manifest is not an authorization to send.
BSC_CAMPAIGN_STATE=PROPOSED
BSC_CAMPAIGN_ID=
# sha256 of the release bsc_runtime binary and of bsc/config/ingress.public.env (hex); the run manifests' host.
BSC_CAMPAIGN_BUILD_SHA256=
BSC_CAMPAIGN_CONFIG_SHA256=
BSC_CAMPAIGN_CHAIN_ID=56
BSC_CAMPAIGN_HOST=
# The granted builders (the permitted sinks: CLUB48_BUILDER_V1, BLOCKRAZOR_BUILDER_V1) and triggering sources
# (BSC_INGRESS_*), comma-separated; the operator's own launcher wallets (0x addresses, comma-separated, or NONE).
BSC_CAMPAIGN_ADAPTERS=
BSC_CAMPAIGN_SOURCES=
BSC_CAMPAIGN_SELF_LAUNCHERS=
# Enabled cells, comma-separated: EXTERNAL_FULL_LAUNCH (another creator's launch), SELF_LAUNCH (the operator's own).
BSC_CAMPAIGN_CELLS=
BSC_CAMPAIGN_EXTERNAL_FULL_LAUNCH_MIN_ATTEMPTS=
BSC_CAMPAIGN_EXTERNAL_FULL_LAUNCH_MIN_DURATION_S=
BSC_CAMPAIGN_SELF_LAUNCH_MIN_ATTEMPTS=
BSC_CAMPAIGN_SELF_LAUNCH_MIN_DURATION_S=
# Why these counts and durations support the intended reliability claim; the workload/concurrency and the
# failure scenarios the campaign runs through.
BSC_CAMPAIGN_SAMPLE_RATIONALE=
BSC_CAMPAIGN_WORKLOAD=
BSC_CAMPAIGN_FAILURE_SCENARIOS=
# The launch eligibility the C3 path has (the only one): a canonical Flap launch of the C1 scope.
BSC_CAMPAIGN_ELIGIBILITY=CANONICAL_FLAP_C1_SCOPE
# Coverage floor: the observed eligible launches left without an attempt (ppm of them) and in a row.
BSC_CAMPAIGN_MAX_SKIP_PPM=
BSC_CAMPAIGN_MAX_CONSECUTIVE_MISSES=
# The share of the campaign's time its sealed runs must cover (ppm): launches while no run was up are no skips.
BSC_CAMPAIGN_MIN_COVERED_PPM=
# Chain no sealed run followed (beyond a restart's catch-up): OPEN holds the campaign open (master plan §13 J: no
# launch leaves the denominator unseen); BOUNDED (an operator decision) counts it only against the floor above.
BSC_CAMPAIGN_UNCOVERED=
# The producer witness access (§9) and the largest remaining clock uncertainty a witness may have (ns).
BSC_CAMPAIGN_PRODUCER_WITNESS=
BSC_CAMPAIGN_CLOCK_ERROR_BOUND_NS=
BSC_CAMPAIGN_PLACEMENT=FIRST_AFTER_LAUNCH
# Blocks above an inclusion before it counts as canonical; above a market window's end before it counts complete.
BSC_CAMPAIGN_FINALITY_BLOCKS=
BSC_CAMPAIGN_REORG_HORIZON_BLOCKS=
# The funded-test authorization, the most one attempt may put in and the campaign may cost in all (wei).
BSC_CAMPAIGN_AUTHORIZATION_REF=
BSC_CAMPAIGN_AMOUNT_LIMIT_WEI=
BSC_CAMPAIGN_COST_LIMIT_WEI=
BSC_CAMPAIGN_STOP_CONDITIONS=
BSC_CAMPAIGN_REVIEWER=
# The cell the release claims.
BSC_CAMPAIGN_RELEASE_SCOPE=
