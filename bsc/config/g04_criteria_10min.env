# REV.1.0 R8 (BSC3-064): a ten-minute G0.4 run under the rules of g04_criteria.env, PROPOSED: it rates nothing
# (CRITERIA_UNCONFIRMED) until the user confirms it and it is pre-committed, as that file. Confirmed, it rates a short
# capture (the census-to-verdict path); a run shorter than a day never qualifies a LIVE source and the status shows
# it NOT_EVALUABLE (SHORT_CAMPAIGN). It counts the observable time (a source connected) instead of the runtime; the
# sample minimums are 1 (the launch rate is the result). Use: bsc_runtime g04-verdict --criteria <this file>.
BSC_G04_CRITERIA_STATE=PROPOSED
BSC_G04_CAMPAIGN_MINUTES=10
BSC_G04_COVERAGE_BASIS=OBSERVABLE
BSC_G04_MIN_COVERED_PPM=800000
BSC_G04_MIN_LAUNCHES_FLAP=1
BSC_G04_MIN_LAUNCHES_CLASSIC=1
BSC_G04_MIN_LAUNCHES_OPENFOUR=1
BSC_G04_CONTINUE_ACTIONABLE_PPM=300000
BSC_G04_CONTINUE_LEAD_P50_US=100000
BSC_G04_STOP_ACTIONABLE_PPM=50000
BSC_G04_SENDABLE_LEAD_US=1000
