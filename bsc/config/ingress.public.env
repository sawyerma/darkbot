# Public read-only signal sources of the BSC runtime (plan §5a.2, FREE_ONLY).
# No keys, no paid endpoint. A source without an endpoint here is UNQUALIFIED.
# The runtime only connects a source its native owner made effective SHADOW.
BSC_INGRESS_PUBLICNODE_WSS=wss://bsc-rpc.publicnode.com
BSC_INGRESS_DRPC_WSS=wss://bsc.drpc.org
# REV.1.0 R6: the local bsc-geth source over its C1.4 arena (absent here: UNQUALIFIED). Set together:
# BSC_INGRESS_GETH_ARENA=<absolute arena directory>, BSC_INGRESS_GETH_GENERATION, BSC_INGRESS_GETH_PEER_LANES (max peers
# + churn reserve, at most 256), BSC_INGRESS_GETH_IDLE_US (wait after an empty poll), BSC_INGRESS_GETH_DEDUP_SETS (a power
# of two). Its records' signers are recovered from the signed bytes (legacy EIP-155 and typed), as the WSS sources verify.
# Open: alive every BSC_RUNTIME_QUIET_MS / 2; not open or shut by its node: tried again after BSC_RUNTIME_BACKOFF_INITIAL_MS.
# Runtime bounds (validated at start; out of range stops the runtime).
# BSC_RUNTIME_QUEUE_EVENTS: events (not bytes) of each source's own ingress queue (five queues; R6: a burst of one source
# drops only its own events), and of the canonical and confirmation queues.
BSC_RUNTIME_QUEUE_EVENTS=65536
BSC_RUNTIME_DEDUP_HASHES=262144
BSC_RUNTIME_QUIET_MS=10000
BSC_RUNTIME_JOURNAL_QUEUE=4096
# Segmented capture (Phase F): byte budget of the queued records (>= the largest record), segment
# rotation by bytes or record time, durability sync after N records or M ms.
BSC_RUNTIME_JOURNAL_BUDGET_BYTES=67108864
BSC_RUNTIME_JOURNAL_SEGMENT_BYTES=268435456
BSC_RUNTIME_JOURNAL_SEGMENT_MS=600000
BSC_RUNTIME_JOURNAL_SYNC_RECORDS=256
BSC_RUNTIME_JOURNAL_SYNC_MS=1000
# Pending transactions journaled besides launches: LAUNCHES (none), VENUES (addressed to the Portal,
# TokenManager2 or OpenFour Core: the competitor flow) or ALL. A Phase-F capture chooses VENUES or ALL.
BSC_RUNTIME_CAPTURE_PENDING=LAUNCHES
# Capacity preflight of a scoped capture (bsc_runtime capture-preflight): planned duration (Phase F: 30 min),
# bytes the writer probe writes on the capture volume, the shortest sealed run that measures the rates,
# free bytes kept on it.
BSC_RUNTIME_CAPTURE_DURATION_S=1800
BSC_RUNTIME_PREFLIGHT_PROBE_BYTES=67108864
BSC_RUNTIME_PREFLIGHT_MIN_RATES_S=300
# Phase H Strategy C (component BSC_STRATEGY_C; SHADOW is a PAPER ledger, nothing is signed or sent): the original
# backend's policy. Observation window, ratio places, first-buyer window, filters (feature:min:max,...; empty: none),
# net multiples (target, stop), hold, open positions, PAPER input, fill delay (blocks; the fill is taken last in its
# block, an assumption), a creator sale before the fill (FREE_CANCEL|TX_LANDS), the gas price and the frozen gas
# evidence of the costs. A minimal activity research profile (at least two buys of two distinct buyers in the window,
# besides the launch transaction) so filters and features are exercised: no tuning and no expected-value claim.
BSC_STRATEGY_C_OBSERVATION_MS=3000
BSC_STRATEGY_C_RATIO_PLACES=4
BSC_STRATEGY_C_FIRST_BUYER_WINDOW=5
BSC_STRATEGY_C_FILTERS=buy_count:2:,unique_buyers:2:
BSC_STRATEGY_C_TARGET_NET_MULTIPLE=2
BSC_STRATEGY_C_STOP_NET_MULTIPLE=0.5
BSC_STRATEGY_C_HOLD_MS=600000
BSC_STRATEGY_C_MAX_OPEN=5
BSC_STRATEGY_C_INPUT_WEI=10000000000000000
BSC_STRATEGY_C_FILL_DELAY_BLOCKS=1
BSC_STRATEGY_C_CREATOR_SOLD_BEFORE_FILL=FREE_CANCEL
# The strategy's network cost is priced at the gas price its PAPER intents are signed with (BSC_EXEC_GAS_PRICE_WEI;
# the runtime refuses a difference).
BSC_STRATEGY_C_GAS_PRICE_WEI=50000000
BSC_STRATEGY_C_GAS_EVIDENCE=bsc/native/evidence/gas/receipts_20261026.txt,bsc/native/evidence/gas/flap_gas_20261031.txt,bsc/native/evidence/gas/flap_gas_20261031_w130100000.txt,bsc/native/evidence/gas/flap_gas_20261031_w130500000.txt
BSC_RUNTIME_DISK_RESERVE_BYTES=10737418240
BSC_RUNTIME_STATUS_MS=1000
# Audit E 3.3: a status older than this many of its intervals is stale for every reader (written into the record).
BSC_RUNTIME_STATUS_STALE_INTERVALS=3
# Audit E 3.1/3.4: the owner's bounds. At most this many BUY attempts a UTC day or in the whole campaign
# (the user's decision 27.10./28.10.: at most ten real BUY attempts; range 1..=10), and the owner
# generations kept besides the current one (a request's lost receipt resolves within them).
BSC_BUY_ATTEMPTS_TOTAL_MAX=10
BSC_OWNER_KEEP_GENERATIONS=64
# WSS adapter bounds (per source).
BSC_RUNTIME_CONNECT_TIMEOUT_MS=5000
BSC_RUNTIME_HANDSHAKE_TIMEOUT_MS=15000
BSC_RUNTIME_READ_TICK_MS=200
BSC_RUNTIME_WRITE_TIMEOUT_MS=5000
BSC_RUNTIME_IDLE_TIMEOUT_MS=60000
BSC_RUNTIME_MAX_FRAME_BYTES=1048576
BSC_RUNTIME_MAX_MESSAGE_BYTES=1048576
BSC_RUNTIME_BACKOFF_INITIAL_MS=1000
BSC_RUNTIME_BACKOFF_MAX_MS=60000
BSC_RUNTIME_STABLE_AFTER_MS=60000
BSC_RUNTIME_CENSUS_MS=60000
# A pass waits at most this long for events before it reconciles, joins and checks stop.
BSC_RUNTIME_RECONCILE_MS=500
# Phase I: a queued canonical event waits at most this long for the pass (the strategy acts on its complete block then).
BSC_RUNTIME_CANONICAL_SLICE_MS=5
# Stop wait before the operator kills the process (>= derived stop path; ops and launchd use it).
BSC_RUNTIME_STOP_TIMEOUT_MS=15000
# The largest launch calldata the Flap decoder accepts (ingress and the follower's C1 scope); larger is oversized.
BSC_RUNTIME_MAX_LAUNCH_CALLDATA=16384
# Canonical chain follower (G0.4 denominator): free public JSON-RPC, read-only.
BSC_CANONICAL_RPC=https://bsc-dataseed.bnbchain.org
# BSC3-036: asked in this order after BSC_CANONICAL_FAILOVER_AFTER consecutive failed steps of the endpoint followed
# (round robin, the kept window carries over and every block is proven against it). The two free dataseeds measured
# 31.10. (10 min, three providers): 390/390 common heads, 0 hash differences, 0 errors, lag to the first p95 193-511 ms.
BSC_CANONICAL_RPC_FALLBACK=https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io
# Three failed steps: with BACKOFF_INITIAL 500 ms doubling, about 1.5 s of failures before the next endpoint is asked.
BSC_CANONICAL_FAILOVER_AFTER=3
# A head that stands still this long is a failed step (an endpoint answering without following): over six times the
# largest lag measured (753 ms) and over six BSC block times.
BSC_CANONICAL_STALL_MS=5000
# BSC3-056: an independent second source (another operator than the followed dataseeds; headers only, its own thread,
# off the hot path). A LIVE BUY goes only while it confirms the followed chain: equal hashes at the highest height both
# hold, its newest header at most MAX_AGE_MS old and at most MAX_LAG_BLOCKS below the followed head; exits go on.
# Measured 31.10. (10 min, PublicNode among three free providers): 390/390 common heads equal, lag to the first p95
# 193-511 ms, max 321-753 ms: 3000 ms is four times the largest lag, 2 blocks over two BSC block times.
BSC_CANONICAL_CONFIRM_RPC=https://bsc-rpc.publicnode.com
BSC_CANONICAL_CONFIRM_MAX_AGE_MS=3000
BSC_CANONICAL_CONFIRM_MAX_LAG_BLOCKS=2
# 01.11. (R1): an open LIVE lot the strategy does not hold (a restart, a gap or a reorg ended its tracking) is held again
# on its curve read at a block's end (getTokenV8Safe + nftGate pinned to the block, 3 requests on the followed endpoint):
# at most this many such reads at a time (the open lots, at most the grant's max_open_positions, are read in turn), and a lot
# whose read failed or was overtaken by a trade of its token read again no earlier than RETRY_MS (over four BSC blocks,
# below the follower's stall bound, so a slow or failing endpoint is not hammered at block cadence).
BSC_CANONICAL_LOT_READS_MAX=2
BSC_CANONICAL_LOT_READ_RETRY_MS=3000
# A refused answer (outside its ABI, no Portal state) strands its lot only the third time in a row (each read again after
# RETRY_MS, after a failover from another endpoint): one bad answer is not the token's state.
BSC_CANONICAL_LOT_READ_REFUSED_MAX=3
# REV.1.0 R3b (BSC3-024/041): an unresolved LIVE transaction the follower can no longer resolve (its window over, unknown
# or bounding nothing after a reorg, a gap or a restart) is looked up off the loop on the followed endpoint, every block
# final and confirmed by BSC_CANONICAL_CONFIRM_RPC: by its receipt, else by the block where the buyer's nonce passes it
# (a lease's BUY always so). At most READS_MAX at a time, one asked again no earlier than RETRY_MS (a minute: a
# transaction once out of its window is not resolved at block cadence, and each lookup costs a few requests).
BSC_CANONICAL_RECOVERY_READS_MAX=2
BSC_CANONICAL_RECOVERY_RETRY_MS=60000
# The search for the block where the nonce passes reads the buyer's nonce at past blocks (about two log2 of the distance
# requests): at most this many blocks below the transaction's window's end (none: the last final block; 28800 BSC blocks
# are hours; at least BSC_EXEC_LIVE_LEASE_BLOCKS, so a lease's whole window is searched however long ago it ended). It
# needs the endpoint's state at those blocks: one that keeps none (no archive) fails the read, named; beyond the bound
# the transaction is named RECOVERY_BEYOND_SEARCH for the operator. A lease whose nonce stays free is RECOVERY_NOT_FOUND
# and asked again every RETRY_MS (two headers and two nonce reads) until a transaction takes its nonce.
BSC_CANONICAL_RECOVERY_SEARCH_BLOCKS=28800
BSC_CANONICAL_POLL_MS=300
BSC_CANONICAL_REORG_DEPTH=64
BSC_CANONICAL_MAX_CATCH_UP=400
BSC_CANONICAL_CONNECT_TIMEOUT_MS=5000
BSC_CANONICAL_HANDSHAKE_TIMEOUT_MS=10000
BSC_CANONICAL_READ_TICK_MS=200
BSC_CANONICAL_WRITE_TIMEOUT_MS=5000
BSC_CANONICAL_REQUEST_TIMEOUT_MS=15000
BSC_CANONICAL_MAX_RESPONSE_BYTES=67108864
BSC_CANONICAL_BACKOFF_INITIAL_MS=500
BSC_CANONICAL_BACKOFF_MAX_MS=30000
BSC_CANONICAL_JOIN_DELAY_MS=2000
# BSC3-062: a launch's first sighting is at most this long before its block (G0.4 campaign, 82.5 h: launch lead
# p99 0.57 s, max 4.9 s; 60 s is over twelve times the largest). A launch without a remembered sighting is EVICTED
# (not evaluable), not missed, while a hash first seen within it was forgotten for good by the bounded window.
BSC_CANONICAL_JOIN_HORIZON_MS=60000
# Phase E review L3, the Four.meme drift guard: how often the live Four contracts (the proxies' EIP-1967 implementations
# and every frozen runtime code) are read read-only against the freeze at the canonical endpoint, first at start. A drift
# makes every Four token derivation UNKNOWN until a probe matches again; journaled, in the status, capture NOT_CLEAN.
BSC_CANONICAL_FOUR_PROBE_MS=3600000
# A launch transaction answer refused for a provider-side reason is fetched this often, then counted.
BSC_CANONICAL_TX_ATTEMPTS=3
# C2 chain-state owner (component BSC_STATE_C2); its reorg window is BSC_CANONICAL_REORG_DEPTH.
# Held transactions at most (also the largest block); candidates per (sender, nonce) besides the canonical one.
BSC_STATE_MAX_TXS=262144
BSC_STATE_MAX_CANDIDATES_PER_NONCE=16
BSC_STATE_MAX_WATCHED_SENDERS=8
# Blocks above a block until it is final (at most the reorg window).
BSC_STATE_FINALITY_DEPTH=16
# Own accounts that get inclusion/finality/orphan proofs (comma-separated 0x addresses); none in READ_ONLY.
BSC_STATE_WATCHED=
# The retained canonical window is checkpointed this often (and at switch-off and stop).
BSC_STATE_CHECKPOINT_MS=30000
# The watched accounts' next nonce is read (pinned to the block hash) at every this-many blocks.
BSC_STATE_NONCE_FACT_BLOCKS=20
# C3 PAPER path (component BSC_EXEC): production decode, C2 snapshot, admission, build/sign, lane, submission plan
# (48Club bundle of the original launch + BUY), request frame, dispatch -> PAPER sink as transport; never sends. The PAPER identity is a local key outside the repository (bsc_runtime paper-identity init); ~ is $HOME.
BSC_EXEC_PAPER_IDENTITY=~/.darkbot/bsc/paper_identity.key
# Accounts the PAPER identity must never be (production/G0.7 wallets), comma-separated 0x addresses: the frozen G0.7
# launcher and buyer (bsc/tools/g06a_final_dry.sh; Paket 8 review L4: a copied G0.7 key is refused as PAPER identity).
BSC_EXEC_REFUSED_ACCOUNTS=0x3e7B487Ae5e1c49aB1cF6222BDb5cf016e86aacd,0x9c8a0Db41914beEE52Dd49790c4F087E252743DE
# The qualified BUY (trading admission amount; gas price, BUY gas limit and slippage of
# bsc/native/evidence/g06a/g06a_prepare_20261023T211704Z preflight/native_quote); cap = input + gas of one BUY.
BSC_EXEC_INPUT_WEI=1000000000000000
BSC_EXEC_SLIPPAGE_BPS=100
BSC_EXEC_GAS_PRICE_WEI=50000000
BSC_EXEC_GAS_LIMIT=3000000
# The session cap is shared by the whole lane pool (one BUY per token): at one BUY's total, as production, a
# session admits one PAPER BUY; a PAPER measurement run may raise it (no money is involved).
BSC_EXEC_SESSION_CAP_WEI=1150000000000000
BSC_EXEC_POLICY_GENERATION=1
# R12c: the Four.meme Classic BUY on the C3 PAPER path, probed and armed only while BSC_VENUE_FOUR_CLASSIC is SHADOW (Four
# has no LIVE path): its input one of the inputs its economics are witnessed at by execution (four_classic
# QUALIFIED_CLASSIC_INPUTS_WEI), its slippage, and its gas limit at least the largest Classic BUY receipt of the frozen gas
# evidence (BSC3-079; that evidence holds two receipts of the G0.1-era implementation and no launch-block Classic BUY yet,
# so the Four network cost stays UNSUPPORTED); signed at BSC_EXEC_GAS_PRICE_WEI, under the session cap above. All three
# unset: no Four BUY.
BSC_EXEC_FOUR_INPUT_WEI=1000000000000000
BSC_EXEC_FOUR_SLIPPAGE_BPS=100
BSC_EXEC_FOUR_GAS_LIMIT=1000000
# R12d: the OpenFour BUY on the C3 PAPER path, probed and armed only while BSC_VENUE_OPENFOUR is SHADOW (no LIVE path): an
# exact-amount Core.buy on the one executed bonding preset (openfour QUALIFIED_OPENFOUR_INPUTS_WEI, maxPay = the input), its
# slippage, and its gas limit at least the largest OpenFour BUY receipt of the frozen gas evidence (two buyByBudget, BSC3-079)
# and above every executed Core.buy estimate of the parity fixture (OFGAS); under the session cap above. All three unset: no
# OpenFour BUY.
BSC_EXEC_OPENFOUR_INPUT_WEI=1000000000000000
BSC_EXEC_OPENFOUR_SLIPPAGE_BPS=100
BSC_EXEC_OPENFOUR_GAS_LIMIT=2000000
# The adapter capability table's generation; the provider's last block = head + VALIDITY_BLOCKS (BSC-008 A: head+2,
# within the birth-entry window); the transport start deadline after T_ingress (at most the profile's 1 ms);
# the largest adapter request.
BSC_EXEC_CAPABILITY_GENERATION=1
BSC_EXEC_VALIDITY_BLOCKS=2
BSC_EXEC_START_LIMIT_NS=1000000
BSC_EXEC_MAX_FRAME_BYTES=65536
# While armed the deployment, terms and PAPER balance are probed again this often; any drift disarms (no re-arm),
# and so do more than REPROBE_FAILURES failed re-probes in a row (PAPER never sends; each failure is visible).
BSC_EXEC_REPROBE_MS=30000
BSC_EXEC_REPROBE_FAILURES=2
# Single-intent lanes armed per start (one per PAPER BUY), calldata bound, latency samples kept for the status.
BSC_EXEC_LANES=64
BSC_EXEC_MAX_CALLDATA=16384
BSC_EXEC_LATENCY_SAMPLES=4096
# Phase I: Strategy C's PAPER intents through the same path (decision -> admission -> intent -> PAPER signature -> lane
# -> plan -> PAPER sink, the local node's single-raw-transaction adapter). Lanes: one per nonce of the PAPER sender's
# sequence (BUY n, approval n+1, SELL n+2, across positions; from n+1 once a C3 BUY took n, while a strategy intent
# holding n refuses C3's), so a round trip takes three; 3000 = 1000 round trips per arming. The cap bounds the open exposure (an exit releases its input) plus the session's gas: at least
# BSC_STRATEGY_C_MAX_OPEN x (INPUT + GAS_PRICE x GAS_LIMIT) = 5 x 0.01015 BNB per venue (SC4: MAX_OPEN counts each venue's
# positions apart; with more venues admitted the cap refuses what exceeds it), the rest for the exits' gas (PAPER: no
# money). The approval and SELL gas limits lie above the largest observed receipts of the v5.27.2 gas
# evidence (BSC3-079: three windows, approval 49255, SELL 784359; the runtime refuses to start otherwise).
# BSC_EXEC_GAS_LIMIT likewise above the largest BUY (974673) and BUY in a launch block (788083).
BSC_EXEC_STRATEGY_LANES=3000
BSC_EXEC_STRATEGY_SESSION_CAP_WEI=100000000000000000
BSC_EXEC_APPROVE_GAS_LIMIT=100000
BSC_EXEC_SELL_GAS_LIMIT=1500000
# Phase I gate L-a: a strategy intent is formed only on a canonical head at most this old (its timestamp, whole
# seconds, against the wall clock): a follower catching up after a lag does not act on old blocks as if fresh
# (refusal STALE_HEAD). 3000 ms: a few 0.45 s blocks plus the follower's delivery and under 1 s of truncation.
BSC_EXEC_STRATEGY_MAX_HEAD_AGE_MS=3000
# BSC3-036: a LIVE release (BUY or exit, C3 or Strategy C) plans only on a canonical head at most this old (its
# timestamp, whole seconds, against the wall clock): a stalled or cut-off canonical source releases nothing (refusal
# STALE_HEAD, before the owner's admission). 3000 ms as above.
BSC_EXEC_LIVE_MAX_HEAD_AGE_MS=3000
# BSC3-030: an open position's exit goes on after its own APPROVE or SELL reverted (a new decision at a later nonce
# through its own owner admission), at most until this many of its exit steps reverted (counted in the ledger, across
# restarts); then, or at once when the reverted step used all its gas (the same limit fails again), its exits stop
# for the operator (refusal EXIT_STOPPED, never an automatic repetition). 2: one new attempt after a revert.
BSC_EXEC_LIVE_EXIT_REVERTS_MAX=2
# BSC3-076: a launch's C3 BUY is admitted by the owner before the launch is seen (its slots, spend and window on the
# medium), as a lease of this many blocks, renewed before half are gone: the entry path writes nothing before its
# first byte. A crash leaves the lease's nonce locked at most this long (then taken again, or the BUY adopted if it
# landed). 200 blocks (~90 s at 0.45 s): at least twice BSC_EXEC_VALIDITY_BLOCKS.
BSC_EXEC_LIVE_LEASE_BLOCKS=200
# REV.1.0 R3: an operator's `bsc_runtime live lot exit-now` (an EXIT_REQUESTED ledger fact) wants the lot's exit now:
# the strategy's own exit at its price, through the owner's admission. OFF: the request is held back and counted
# (OPERATOR_EXIT_LOCKED), the CLI refuses it. The operator switches it ON.
BSC_EXEC_LIVE_OPERATOR_EXIT=OFF
# REV.1.0 R3b: an operator's `bsc_runtime live nonce-burn` (a BURN_REQUESTED ledger fact) of an unresolved transaction
# whose signed bytes may still land (its block left the chain, or its window is unknown; it keeps the LIVE path from
# arming) burns its nonce: the buyer's plain transfer of nothing to itself at that nonce, through the armed path and the
# owner's admission like an exit step. OFF: held back and counted (NONCE_BURN_LOCKED), the CLI refuses it. A burn
# that never landed is not sent again at the same gas price (NONCE_BURN_SPENT): another goes once
# BSC_EXEC_GAS_PRICE_WEI and BSC_STRATEGY_C_GAS_PRICE_WEI change together.
BSC_EXEC_LIVE_NONCE_BURN=OFF
# REV.1.0 R4 (PHASENPLAN §20): ON lets public WSS sources (PublicNode, dRPC, BlockReq) be a C3 BUY's only LIVE
# signals. OFF: C3 BUYs only while some effective-LIVE source of the grant is not public and signals (R6: healthy and
# its last verified full transaction (the local geth: its open arena) within BSC_RUNTIME_QUIET_MS at the runtime's last
# status pass); counted
# SOURCE_UNHEALTHY while such a source exists but does not signal, SOURCE_PUBLIC_ONLY otherwise.
BSC_EXEC_LIVE_PUBLIC_ONLY=OFF
# REV.1.0 R4 (BSC3-059): the longest a LIVE grant may still run for a BUY to go (ms; its remaining time: a longer
# grant admits BUYs once within it); 0: no bound (the operator's decision). Beyond it BUYs are refused
# (LIVE_GRANT_DURATION_ABOVE_MAX), exits go on.
BSC_EXEC_LIVE_GRANT_MAX_DURATION_MS=0
# REV.1.0 R8 (BSC3-049): the oldest the LIVE qualification (its record's observed time) may be for a BUY to go (ms);
# 0: no bound (the operator's decision). Older: BUYs are refused (LIVE_QUALIFICATION_STALE), exits go on.
BSC_EXEC_LIVE_QUALIFICATION_MAX_AGE_MS=0
# Audit E 3.2 (BSC3-065): the executed cases a behaviour parity needs per traded path at the least (range 30..=1000).
BSC_EXEC_LIVE_PARITY_MIN_EXECUTED_PER_PATH=30
# REV.1.0 R9 (BSC3-001): the operator's presence address (0x + 40 hex; empty: OFF, the default). Set, a BUY needs the
# grant signed by its key for the generation it is written as: `bsc_runtime live scope ... --expect-generation N`
# prints presence_digest, the operator signs those 32 bytes as a personal_sign message with a key this account never
# holds and grants with `bsc_runtime live grant ... --expect-generation N --presence-signature 0x<130 hex>` (the GUI
# grants unsigned); unsigned, signed by another key or for another generation: LIVE_PRESENCE_UNSIGNED, exits go on.
# A process of this account can still edit this file: a second anchor, not an account boundary. The signature is in
# the owner state: the reporter is built with the runtime (darkbotctl build), no rollback before R9 while it is set.
BSC_EXEC_LIVE_PRESENCE_ANCHOR=
# REV.1.0 R10: the LIVE path (plan 28.10.); all three empty: none (the default). The operator sets them on this host
# (the snapshot then names its source -dirty, a real deviation): the buyer's key file outside the repository
# (`bsc_runtime live key init --key PATH --root DIR` draws one and prints its address), that address (also one of
# BSC_STATE_WATCHED), BUILDERS (TLS to the granted builders) or LOOPBACK:<port> (the stand-in, tests only); the
# BlockRazor authorization from a private file outside the repository, if BlockRazor is granted. `bsc_runtime
# config-check --config FILE` checks them without reading the key (darkbotctl runs it before it starts the runtime).
BSC_LIVE_KEY=
BSC_LIVE_BUYER=
BSC_LIVE_ROUTE=
BSC_LIVE_BLOCKRAZOR_TOKEN_FILE=
BSC_LIVE_CONNECT_TIMEOUT_MS=5000
# REV.1.0 R4: the campaign's cumulative worst-case budget (wei) every LIVE BUY with its exits is admitted within, all
# grants together (the owner's admissions, never released); 0: no BUY (LIVE_CAMPAIGN_SPEND_EXHAUSTED). The operator
# sets it net of the G0.7 attempt's worst case (G0.7 spends outside the owner's admissions); nothing raises it.
BSC_EXEC_LIVE_SPEND_TOTAL_WEI=0
# REV.1.0 R4 (BSC3-069): a grant whose risk is above these soft bounds (a BUY's, an exit's slippage, bps; the gas price,
# wei: the qualified values; the operator's thresholds) is an outlier. It admits BUYs only when its scope confirms it (risk_outlier_ack)
# and BSC_EXEC_LIVE_RISK_OUTLIER is ON; otherwise LIVE_RISK_OUTLIER_UNACKED / LIVE_RISK_OUTLIER_LOCKED (exits go on).
BSC_EXEC_LIVE_RISK_SOFT_BUY_SLIPPAGE_BPS=100
BSC_EXEC_LIVE_RISK_SOFT_EXIT_SLIPPAGE_BPS=100
BSC_EXEC_LIVE_RISK_SOFT_GAS_PRICE_WEI=50000000
BSC_EXEC_LIVE_RISK_OUTLIER=OFF
# REV.1.0 R4 (BSC3-042): ON renews the LIVE arm after a C3 BUY whose nonce the chain took (the free nonce past the
# arm's, nothing unresolved), so the next C3 BUY can go; OFF (default): one C3 BUY per arm (SENDER_NONCE after it).
BSC_EXEC_LIVE_C3_REARM=OFF
# REV.1.0 R4: the bound builder policy (repository-relative) every LIVE arm rests on: its oldest fetched source at most
# 24 h old (an import is never fresh), both builders verified, the signed gas price at its strictest floor or above;
# checked every pass (a refresh applies at the next); otherwise BUYs close (LIVE_BUILDER_POLICY_STALE / _UNVERIFIED /
# LIVE_GAS_PRICE_BELOW_BUILDER_FLOOR), exits go on. The frozen import: no BUY until the operator binds a fresh native one.
BSC_EXEC_LIVE_BUILDER_POLICY=bsc/native/evidence/g06a/g07_binary_import_20261016/builder_policy.dbrec
# REV.1.0 R5 (BSC3-030): an exit step (approval, SELL) whose window is over unresolved goes again at the same nonce at
# its price raised by these bps, at most the grant's max_gas_price_wei; 0 (default): never re-priced, its same bytes are
# refused (LIVE_INTENT_SEEN) and the exit waits for the operator. A higher price is a new sandwich/overpay exposure;
# with it ON every lot's exit is reserved at the grant's max gas price (fewer BUYs fit the grant's spend).
BSC_EXEC_LIVE_EXIT_REPRICE_BPS=0
# REV.1.0 R5 (BSC3-030): ON also sends every LIVE exit step (approval, SELL), once handed to the builders, to the public
# JSON-RPC endpoint BSC_EXEC_LIVE_PUBLIC_EXIT_RPC (https://) as eth_sendRawTransaction: the public mempool (a SELL can be
# sandwiched within its slippage; the operator's decision). Never a BUY. OFF (default) with no endpoint. The endpoint
# goes into this public file: one without credentials. Public bytes stay valid until their nonce is taken (a block window
# does not end them); a public replacement needs the mempool's price bump (geth's default 10 %: REPRICE_BPS >= 1000).
BSC_EXEC_LIVE_PUBLIC_EXIT=OFF
BSC_EXEC_LIVE_PUBLIC_EXIT_RPC=
# REV.1.0 R5 (BSC3-030): ON exits a LIVE lot whose token migrated to its DEX (stranded LIVE_POSITION_MIGRATED): the
# Portal's quoteExactInput at a canonical block, then the approval and swapExactInput (the Portal routes it through its
# DEX router) at that quote minus the exit slippage. OFF (default): the lot stays stranded for the operator. Real DEX
# quotes and receipts are not yet verified (after 03.11.); a DEX-routed SELL without the Portal's trade event books its
# proceeds as unknown.
BSC_EXEC_LIVE_DEX_EXIT=OFF
# REV.1.0 R7 (BSC3-056): ON: while the second source (BSC_CANONICAL_CONFIRM_RPC) holds another block at a height of the
# followed chain (DISAGREES), nothing LIVE is sent, exits neither (counted UNCONFIRMED). OFF: only BUYs wait (the
# operator's decision). The followed blocks themselves are refused unless their hash is their header's and their
# transactions, signers and receipts are the ones it commits to.
BSC_EXEC_LIVE_DIVERGENCE_QUARANTINE=OFF
# Phase I gate M2: the PAPER paths that take the PAPER sender's nonce sequence in one arm: C3, STRATEGY_C or
# C3+STRATEGY_C. C3's BUYs are alternatives at the next nonce n, Strategy C's intents a sequence from n; with both, the
# first to disclose n owns it (after a C3 BUY the strategy starts at n+1; after a strategy intent every later C3 BUY of
# the arm is refused NONCE_TAKEN). A path left out is refused PATH_OFF. Both counted in the status.
BSC_EXEC_SENDER_PATHS=C3+STRATEGY_C
