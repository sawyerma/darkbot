# Public read-only signal sources of the BSC runtime (plan §5a.2, FREE_ONLY).
# No keys, no paid endpoint. A source without an endpoint here is UNQUALIFIED.
# The runtime only connects a source its native owner made effective SHADOW.
BSC_INGRESS_PUBLICNODE_WSS=wss://bsc-rpc.publicnode.com
BSC_INGRESS_DRPC_WSS=wss://bsc.drpc.org
# Runtime bounds (validated at start; out of range stops the runtime).
BSC_RUNTIME_QUEUE_EVENTS=65536
BSC_RUNTIME_DEDUP_HASHES=262144
BSC_RUNTIME_QUIET_MS=10000
BSC_RUNTIME_JOURNAL_QUEUE=4096
# Segmented capture (Phase F): byte budget of the queued records (>= the largest record), segment
# rotation by bytes or record time, durability sync after N records or M ms.
BSC_RUNTIME_JOURNAL_BUDGET_BYTES=67108864
BSC_RUNTIME_JOURNAL_SEGMENT_BYTES=268435456
BSC_RUNTIME_JOURNAL_SEGMENT_MS=600000
BSC_RUNTIME_JOURNAL_SYNC_RECORDS=256
BSC_RUNTIME_JOURNAL_SYNC_MS=1000
# Pending transactions journaled besides launches: LAUNCHES (none), VENUES (addressed to the Portal,
# TokenManager2 or OpenFour Core: the competitor flow) or ALL. A Phase-F capture chooses VENUES or ALL.
BSC_RUNTIME_CAPTURE_PENDING=LAUNCHES
# Capacity preflight of a scoped capture (bsc_runtime capture-preflight): planned duration (Phase F: 30 min),
# bytes the writer probe writes on the capture volume, the shortest sealed run that measures the rates,
# free bytes kept on it.
BSC_RUNTIME_CAPTURE_DURATION_S=1800
BSC_RUNTIME_PREFLIGHT_PROBE_BYTES=67108864
BSC_RUNTIME_PREFLIGHT_MIN_RATES_S=300
# Phase H Strategy C (component BSC_STRATEGY_C; SHADOW is a PAPER ledger, nothing is signed or sent): the original
# backend's policy. Observation window, ratio places, first-buyer window, filters (feature:min:max,...; empty: none),
# net multiples (target, stop), hold, open positions, PAPER input, fill delay (blocks; the fill is taken last in its
# block, an assumption), a creator sale before the fill (FREE_CANCEL|TX_LANDS), the gas price and the frozen gas
# evidence of the costs. A minimal activity research profile (at least two buys of two distinct buyers in the window,
# besides the launch transaction) so filters and features are exercised: no tuning and no expected-value claim.
BSC_STRATEGY_C_OBSERVATION_MS=3000
BSC_STRATEGY_C_RATIO_PLACES=4
BSC_STRATEGY_C_FIRST_BUYER_WINDOW=5
BSC_STRATEGY_C_FILTERS=buy_count:2:,unique_buyers:2:
BSC_STRATEGY_C_TARGET_NET_MULTIPLE=2
BSC_STRATEGY_C_STOP_NET_MULTIPLE=0.5
BSC_STRATEGY_C_HOLD_MS=600000
BSC_STRATEGY_C_MAX_OPEN=5
BSC_STRATEGY_C_INPUT_WEI=10000000000000000
BSC_STRATEGY_C_FILL_DELAY_BLOCKS=1
BSC_STRATEGY_C_CREATOR_SOLD_BEFORE_FILL=FREE_CANCEL
BSC_STRATEGY_C_GAS_PRICE_WEI=100000000
BSC_STRATEGY_C_GAS_EVIDENCE=bsc/engine/crates/trading/fixtures/bsc/receipts_20261026.txt,bsc/engine/crates/trading/fixtures/bsc/flap_gas_20261026.txt
BSC_RUNTIME_DISK_RESERVE_BYTES=10737418240
BSC_RUNTIME_STATUS_MS=1000
# WSS adapter bounds (per source).
BSC_RUNTIME_CONNECT_TIMEOUT_MS=5000
BSC_RUNTIME_HANDSHAKE_TIMEOUT_MS=15000
BSC_RUNTIME_READ_TICK_MS=200
BSC_RUNTIME_WRITE_TIMEOUT_MS=5000
BSC_RUNTIME_IDLE_TIMEOUT_MS=60000
BSC_RUNTIME_MAX_FRAME_BYTES=1048576
BSC_RUNTIME_MAX_MESSAGE_BYTES=1048576
BSC_RUNTIME_BACKOFF_INITIAL_MS=1000
BSC_RUNTIME_BACKOFF_MAX_MS=60000
BSC_RUNTIME_STABLE_AFTER_MS=60000
BSC_RUNTIME_CENSUS_MS=60000
# A pass waits at most this long for events before it reconciles, joins and checks stop.
BSC_RUNTIME_RECONCILE_MS=500
# Stop wait before the operator kills the process (>= derived stop path; ops and launchd use it).
BSC_RUNTIME_STOP_TIMEOUT_MS=15000
# The largest launch calldata the Flap decoder accepts (ingress and the follower's C1 scope); larger is oversized.
BSC_RUNTIME_MAX_LAUNCH_CALLDATA=16384
# Canonical chain follower (G0.4 denominator): free public JSON-RPC, read-only.
BSC_CANONICAL_RPC=https://bsc-dataseed.bnbchain.org
BSC_CANONICAL_POLL_MS=300
BSC_CANONICAL_REORG_DEPTH=64
BSC_CANONICAL_MAX_CATCH_UP=400
BSC_CANONICAL_CONNECT_TIMEOUT_MS=5000
BSC_CANONICAL_HANDSHAKE_TIMEOUT_MS=10000
BSC_CANONICAL_READ_TICK_MS=200
BSC_CANONICAL_WRITE_TIMEOUT_MS=5000
BSC_CANONICAL_REQUEST_TIMEOUT_MS=15000
BSC_CANONICAL_MAX_RESPONSE_BYTES=67108864
BSC_CANONICAL_BACKOFF_INITIAL_MS=500
BSC_CANONICAL_BACKOFF_MAX_MS=30000
BSC_CANONICAL_JOIN_DELAY_MS=2000
# A launch transaction answer refused for a provider-side reason is fetched this often, then counted.
BSC_CANONICAL_TX_ATTEMPTS=3
# C2 chain-state owner (component BSC_STATE_C2); its reorg window is BSC_CANONICAL_REORG_DEPTH.
# Held transactions at most (also the largest block); candidates per (sender, nonce) besides the canonical one.
BSC_STATE_MAX_TXS=262144
BSC_STATE_MAX_CANDIDATES_PER_NONCE=16
BSC_STATE_MAX_WATCHED_SENDERS=8
# Blocks above a block until it is final (at most the reorg window).
BSC_STATE_FINALITY_DEPTH=16
# Own accounts that get inclusion/finality/orphan proofs (comma-separated 0x addresses); none in READ_ONLY.
BSC_STATE_WATCHED=
# The retained canonical window is checkpointed this often (and at switch-off and stop).
BSC_STATE_CHECKPOINT_MS=30000
# The watched accounts' next nonce is read (pinned to the block hash) at every this-many blocks.
BSC_STATE_NONCE_FACT_BLOCKS=20
# C3 PAPER path (component BSC_EXEC): production decode, C2 snapshot, admission, build/sign, lane, submission plan
# (48Club bundle of the original launch + BUY), request frame, dispatch -> PAPER sink as transport; never sends. The PAPER identity is a local key outside the repository (bsc_runtime paper-identity init); ~ is $HOME.
BSC_EXEC_PAPER_IDENTITY=~/.darkbot/bsc/paper_identity.key
# Accounts the PAPER identity must never be (production/G0.7 wallets), comma-separated 0x addresses.
BSC_EXEC_REFUSED_ACCOUNTS=
# The qualified BUY (trading admission amount; gas price, BUY gas limit and slippage of
# bsc/native/evidence/g06a/g06a_prepare_20261023T211704Z preflight/native_quote); cap = input + gas of one BUY.
BSC_EXEC_INPUT_WEI=1000000000000000
BSC_EXEC_SLIPPAGE_BPS=100
BSC_EXEC_GAS_PRICE_WEI=50000000
BSC_EXEC_GAS_LIMIT=3000000
# The session cap is shared by the whole lane pool (one BUY per token): at one BUY's total, as production, a
# session admits one PAPER BUY; a PAPER measurement run may raise it (no money is involved).
BSC_EXEC_SESSION_CAP_WEI=1150000000000000
BSC_EXEC_POLICY_GENERATION=1
# The adapter capability table's generation; the provider's last block = head + VALIDITY_BLOCKS (BSC-008 A: head+2,
# within the birth-entry window); the transport start deadline after T_ingress (at most the profile's 1 ms);
# the largest adapter request.
BSC_EXEC_CAPABILITY_GENERATION=1
BSC_EXEC_VALIDITY_BLOCKS=2
BSC_EXEC_START_LIMIT_NS=1000000
BSC_EXEC_MAX_FRAME_BYTES=65536
# While armed the deployment, terms and PAPER balance are probed again this often; any drift disarms (no re-arm),
# and so do more than REPROBE_FAILURES failed re-probes in a row (PAPER never sends; each failure is visible).
BSC_EXEC_REPROBE_MS=30000
BSC_EXEC_REPROBE_FAILURES=2
# Single-intent lanes armed per start (one per PAPER BUY), calldata bound, latency samples kept for the status.
BSC_EXEC_LANES=64
BSC_EXEC_MAX_CALLDATA=16384
BSC_EXEC_LATENCY_SAMPLES=4096
