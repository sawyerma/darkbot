{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "darkbot.producer-witness-source.v1.schema.json",
  "title": "DarkBot producer witness source contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "source_ready",
    "original_successful_producer_execution_only",
    "required_witness_schema",
    "delivery_may_be_asynchronous",
    "canonical_identity_binding_required",
    "clock_and_uncertainty_metadata_required",
    "source_description"
  ],
  "properties": {
    "schema": {
      "const": "darkbot.producer-witness-source.v1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ready": {
      "type": "boolean",
      "description": "Whether original-producer witness access is already available for this attempt. false is allowed for G0.7; it leaves T0_TO_BUY UNKNOWN until a valid original witness is delivered."
    },
    "original_successful_producer_execution_only": {
      "const": true
    },
    "required_witness_schema": {
      "const": "bsc/config/producer_execution_witness_v1.schema.json"
    },
    "delivery_may_be_asynchronous": {
      "const": true
    },
    "canonical_identity_binding_required": {
      "const": true
    },
    "clock_and_uncertainty_metadata_required": {
      "const": true
    },
    "source_description": {
      "type": "string",
      "minLength": 1
    },
    "operator_reference": {
      "type": "string"
    }
  }
}
