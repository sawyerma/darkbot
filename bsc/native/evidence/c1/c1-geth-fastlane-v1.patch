+// fastLaneOutboundLoop consumes exact signed transaction bytes from the
+// Rust->geth SPSC ring and hands the same inner transaction envelope to
+// selected ETH peers. A successful p2p.Send return is recorded separately; it
+// is not remote receipt, inclusion or execution.
+func (h *handler) fastLaneOutboundLoop() {
+	defer h.wg.Done()
+	spins := uint32(0)
+	for {
+		select {
+		case <-h.stopCh:
+			return
+		default:
+		}
+
+		record, ok, err := fastlane.TryOutbound()
+		if err != nil {
+			log.Error("DarkBot Fast Lane outbound stopped", "err", err)
+			return
+		}
+		if !ok {
+			spins++
+			if spins&1023 == 0 {
+				runtime.Gosched()
+			}
+			continue
+		}
+		spins = 0
+		if record.Kind != fastlane.OutboundSignedTx {
+			log.Error("DarkBot Fast Lane unexpected outbound record", "kind", record.Kind)
+			return
+		}
+		var tx types.Transaction
+		if err := tx.UnmarshalBinary(record.Payload); err != nil {
+			log.Error("DarkBot Fast Lane invalid signed transaction", "err", err)
+			return
+		}
+		if tx.Hash() != record.Hash {
+			log.Error("DarkBot Fast Lane outbound hash mismatch", "have", tx.Hash(), "want", record.Hash)
+			return
+		}
+
+		wanted := fastlane.OutboundFanout()
+		sent := 0
+		for _, peer := range h.peers.allNonEVNPeers() {
+			if sent >= wanted {
+				break
+			}
+			if peer.KnownTransaction(record.Hash) {
+				continue
+			}
+			if err := peer.SendRawTransaction(record.Hash, record.Payload); err != nil {
+				continue
+			}
+			peerID := peer.NodeID()
+			fastlane.PublishOutboundHandoff(record.Hash, peerID[:])
+			sent++
+		}
+	}
+}
