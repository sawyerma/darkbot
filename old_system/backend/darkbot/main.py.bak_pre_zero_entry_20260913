"""Entry point (LEAN_V1 section 4): wiring only, no trading logic.

    PYTHONPATH=. python -m darkbot.main run --mode SHADOW --chain-ws-url wss://... [--pumpportal] [--commitment processed]
    PYTHONPATH=. python -m darkbot.main status

SHADOW: chain stream -> MarketDataService -> SQLite. No strategy, no trading. Stops on SIGTERM/SIGINT with a
controlled shutdown (PROCESS_RESTART interval, launches evicted with data_complete=0, session closed, writer flushed).
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import signal
import sys
from pathlib import Path
from typing import Any

from darkbot.cli import ContractError, sha256_json
from darkbot.clock import LiveClock, LiveScheduler
from darkbot.config import ConfigError, Limits, StrategyConfig, load_limits, load_protocol_fee_config, load_strategy
from darkbot.domain import InsertOp, Mode, ModelKind, SessionRow, Severity, StorageState, SystemEventRow, SystemState, UpdateOp, feature_names, load_contract, new_text_id
from darkbot.market import ChainLogSource, MarketDataService, PumpPortalCreateSource
from darkbot.execution import LatencyAssumptions, NetworkCostAssumptions, PaperFillModel, ProtocolFeeConfig
from darkbot.paper import PaperRuntime
from darkbot.storage import IdAllocator, StorageReader, StorageWriter, apply_migrations, find_model_id, model_row, open_connection

ENV_CODE_COMMIT = "DARKBOT_CODE_COMMIT"
EXIT_OK, EXIT_FATAL, EXIT_CONFIG, EXIT_SCHEMA = 0, 1, 2, 3


class Controller:
    """BotController (SHADOW subset): start, session, system state in RAM, storage state RAM-first, shutdown."""

    def __init__(
        self,
        contract: dict[str, Any],
        contract_version: str,
        limits: Limits,
        db_path: Path,
        migrations_dir: Path,
        mode: Mode,
        strategy: StrategyConfig | None = None,
        protocol_fees: ProtocolFeeConfig | None = None,
        max_open_positions: int = 1,
        account_rent_lamports: int = 0,
    ) -> None:
        self.contract = contract
        self.contract_version = contract_version
        self.limits = limits
        self.db_path = db_path
        self.migrations_dir = migrations_dir
        self.mode = mode
        self.strategy = strategy
        self.protocol_fees = protocol_fees
        self.max_open_positions = max_open_positions
        self.account_rent_lamports = account_rent_lamports
        self.state = SystemState.STARTING_RECONCILIATION
        self.storage_state = StorageState.OK
        self.pending_audit: list[dict[str, Any]] = []
        self.stop_requested: asyncio.Event | None = None
        self.exit_code = EXIT_OK

    async def run(self) -> int:
        loop = asyncio.get_running_loop()
        clock = LiveClock()
        connection = open_connection(self.db_path, self.limits)
        apply_migrations(connection, self.migrations_dir, self.contract_version)
        now_utc = clock.utc_ns()
        limits_content = self.limits.contract_limits_content(self.contract)
        feature_set_content = {
            "feature_names": list(feature_names(self.contract)),
            "feature_contract_sha256": sha256_json(self.contract["feature_contract_v1"]),
            "runtime_snapshot_ms": list(self.limits.runtime_snapshot_ms),
            "research_snapshot_ms": [int(x) for x in self.contract["strategy"]["research_replay_snapshot_ms"]],
        }
        model_ops = []
        model_ids: dict[str, str] = {}
        for kind, content, source in ((ModelKind.OPERATIONAL_LIMITS.value, limits_content, "contract operational_limits_v1 initial values"), (ModelKind.FEATURE_SET.value, feature_set_content, "contract feature_contract_v1")):
            existing = find_model_id(connection, kind, sha256_json(content))
            if existing is None:
                row = model_row(kind, content, source, now_utc)
                model_ops.append(InsertOp(row))
                model_ids[kind] = row.id
            else:
                model_ids[kind] = existing
        sequence = int(connection.execute("SELECT COALESCE(MAX(persistent_session_sequence), 0) FROM sessions").fetchone()[0]) + 1
        ids = IdAllocator(connection)
        session_id = new_text_id()
        session = SessionRow(
            session_id, sequence, self.mode.value, None, self.contract_version, os.environ.get(ENV_CODE_COMMIT, "unknown"), None, None, None, None, None, None,
            model_ids[ModelKind.OPERATIONAL_LIMITS.value], None, clock.started_at_utc_ns, clock.started_at_monotonic_ns, None, 1,
        )
        writer = StorageWriter(connection, loop, self.limits, self.on_storage_state)
        writer.start()
        await asyncio.wait_for(writer.enqueue_critical([*model_ops, InsertOp(session)]), timeout=self.limits.critical_ack_timeout_ms / 1000)
        scheduler = LiveScheduler(loop, clock)

        paper_runtime: PaperRuntime | None = None
        if self.mode == Mode.PAPER:
            if self.strategy is None or self.protocol_fees is None:
                raise RuntimeError("PAPER requires strategy and protocol fee configuration")
            fill_model = PaperFillModel(
                self.protocol_fees,
                NetworkCostAssumptions(
                    self.strategy.base_fee_lamports,
                    self.strategy.priority_fee_lamports,
                ),
                LatencyAssumptions(
                    0,
                    0,
                    self.strategy.entry_latency_ms,
                    self.strategy.entry_latency_ms,
                    "ASSUMED",
                ),
            )
            paper_runtime = PaperRuntime(
                self.strategy,
                fill_model,
                scheduler,
                clock,
                self.max_open_positions,
                self.account_rent_lamports,
            )

        service = MarketDataService(
            self.contract,
            self.limits,
            clock,
            scheduler,
            writer,
            ids,
            session_id,
            sequence,
            model_ids[ModelKind.FEATURE_SET.value],
            on_snapshot=paper_runtime.on_snapshot if paper_runtime is not None else None,
            on_curve_state=paper_runtime.on_curve_state if paper_runtime is not None else None,
        )
        self.service = service
        self.paper_runtime = paper_runtime
        self.writer = writer
        self.ids = ids
        self.session_id = session_id
        config_details = {
            "code": "SESSION_CONFIG", "message": "session started", "mode": self.mode.value, "chain_commitment": self.limits.chain_commitment,
            "chain_ws_host": self.limits.chain_ws_url.split("?", 1)[0], "pumpportal": self.limits.pumpportal_ws_url is not None,
            "research_horizon_ms": self.limits.research_horizon_ms, "runtime_snapshot_ms": list(self.limits.runtime_snapshot_ms),
            "operational_limits_model_id": model_ids[ModelKind.OPERATIONAL_LIMITS.value], "feature_set_model_id": model_ids[ModelKind.FEATURE_SET.value],
        }
        service.system_event("SESSION_CONFIG", Severity.INFO, config_details)
        await self.transition(SystemState.RUNNING, "startup complete", "startup")
        self.stop_requested = asyncio.Event()
        for signum in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(signum, self.request_stop, signum.name)
        chain = ChainLogSource(self.limits, clock, service.on_notification, service.on_connection)
        tasks = [asyncio.create_task(chain.run(), name="chain-source")]
        pumpportal = None
        if self.limits.pumpportal_ws_url:
            pumpportal = PumpPortalCreateSource(self.limits, clock, service.on_pumpportal_create)
            tasks.append(asyncio.create_task(pumpportal.run(), name="pumpportal-source"))
        service.start_health_sampler()
        print(json.dumps({"event": "RUNNING", "session_id": session_id, "sequence": sequence, "db": str(self.db_path)}), flush=True)
        await self.stop_requested.wait()
        service.stop_accepting()
        if paper_runtime is not None:
            paper_runtime.stop()
        await chain.close()
        if pumpportal is not None:
            await pumpportal.close()
        for task in tasks:
            task.cancel()
        await asyncio.gather(*tasks, return_exceptions=True)
        service.close_all()
        await self.transition(SystemState.STOPPED, "controlled shutdown", "signal")
        await asyncio.wait_for(
            writer.enqueue_critical([UpdateOp("sessions", {"id": session_id}, {"ended_at_utc_ns": clock.utc_ns(), "final_state": SystemState.STOPPED.value})]),
            timeout=self.limits.critical_ack_timeout_ms / 1000,
        )
        await writer.stop()
        summary = {"event": "STOPPED", "session_id": session_id, **service.counters.as_dict(), "committed_rows": writer.committed_rows, "dropped_envelopes": writer.dropped_envelopes, "storage_failures": writer.failures}
        if paper_runtime is not None:
            summary["paper"] = paper_runtime.summary()
        print(json.dumps(summary), flush=True)
        return self.exit_code

    def request_stop(self, reason: str) -> None:
        print(json.dumps({"event": "STOP_REQUESTED", "reason": reason}), file=sys.stderr, flush=True)
        if self.stop_requested is not None:
            self.stop_requested.set()

    async def transition(self, state: SystemState, reason: str, trigger: str) -> None:
        details = {"code": "STATE_CHANGE", "message": reason, "from": self.state.value, "to": state.value, "reason": reason, "trigger": trigger}
        self.state = state
        row = SystemEventRow(self.ids.next("system_events"), self.session_id, "STATE_CHANGE", (Severity.INFO if state == SystemState.RUNNING else Severity.CRITICAL).value, self.service.clock.utc_ns(), json.dumps(details, sort_keys=True))
        try:
            await asyncio.wait_for(self.writer.enqueue_critical([InsertOp(row)]), timeout=self.limits.critical_ack_timeout_ms / 1000)
        except Exception as exc:  # noqa: BLE001 - storage down: RAM state already changed; audit is deferred
            self.pending_audit.append({**details, "deferred_error": str(exc)})

    def on_storage_state(self, state: StorageState, details: dict[str, Any]) -> None:
        """RAM first (contract storage_writer_protocol.failure_bulk): never persist a storage failure through the failing storage."""
        previous, self.storage_state = self.storage_state, state
        record = {"code": details.get("code", state.value), "message": f"storage {state.value}", "utc_ns": self.service.clock.utc_ns(), **details}
        print(json.dumps({"event": "STORAGE_STATE", **record}), file=sys.stderr, flush=True)
        if state == StorageState.CRITICAL:
            self.pending_audit.append(record)
            return
        if previous == StorageState.CRITICAL or state == StorageState.OK:
            for entry in self.pending_audit:
                self.service.system_event(str(entry["code"]), Severity.CRITICAL, entry)
            self.pending_audit.clear()
        if state == StorageState.DEGRADED:
            self.service.system_event("STORAGE_DEGRADED", Severity.WARN, record)


# --------------------------------------------------------------------------- commands


def project_paths(project_root: Path | None, db: Path | None) -> tuple[Path, dict[str, Any], str, Path, Path]:
    active = load_contract(project_root)
    contract = active.document
    root = active.project_root
    db_path = db or root / contract["persistence"]["database_relative_path"]
    migrations = root / contract["persistence"]["migrations_dir"]
    return root, contract, contract["document"]["version"], db_path, migrations


def command_run(args: argparse.Namespace) -> int:
    root, contract, version, db_path, migrations = project_paths(args.project_root, args.db)
    mode = Mode(args.mode)
    if mode not in (Mode.SHADOW, Mode.PAPER):
        print(f"runtime implements SHADOW and PAPER; {mode.value} is not enabled here", file=sys.stderr)
        return EXIT_CONFIG
    try:
        limits = load_limits(contract, args.chain_ws_url, args.commitment, pumpportal_ws_url=args.pumpportal_ws_url, pumpportal=args.pumpportal, mode=mode.value)
    except ConfigError as exc:
        print(str(exc), file=sys.stderr)
        return EXIT_CONFIG
    strategy: StrategyConfig | None = None
    protocol_fees: ProtocolFeeConfig | None = None
    if mode == Mode.PAPER:
        if args.strategy is None or args.protocol_fee_config is None:
            print("PAPER requires --strategy and --protocol-fee-config", file=sys.stderr)
            return EXIT_CONFIG
        if args.max_open_positions <= 0:
            print("--max-open-positions must be > 0", file=sys.stderr)
            return EXIT_CONFIG
        if args.account_rent_lamports < 0:
            print("--account-rent-lamports must be >= 0", file=sys.stderr)
            return EXIT_CONFIG
        try:
            strategy = load_strategy(args.strategy, contract)
            protocol_fees = load_protocol_fee_config(args.protocol_fee_config)
        except (ConfigError, ValueError) as exc:
            print(str(exc), file=sys.stderr)
            return EXIT_CONFIG

    for relative in ("backend/data", "backend/logs", "backend/exports"):
        (root / relative).mkdir(parents=True, exist_ok=True)
    db_path.parent.mkdir(parents=True, exist_ok=True)
    controller = Controller(
        contract,
        version,
        limits,
        db_path,
        migrations,
        mode,
        strategy,
        protocol_fees,
        args.max_open_positions,
        args.account_rent_lamports,
    )
    try:
        return asyncio.run(controller.run())
    except Exception as exc:  # noqa: BLE001 - fatal during startup/run: report and exit 1
        print(json.dumps({"event": "FATAL", "error": repr(exc)}), file=sys.stderr, flush=True)
        return EXIT_FATAL


def command_status(args: argparse.Namespace) -> int:
    _, contract, _, db_path, _ = project_paths(args.project_root, args.db)
    if not db_path.is_file():
        print(f"no database at {db_path}")
        return EXIT_SCHEMA
    limits = load_limits(contract, chain_ws_url="status://read-only")
    reader = StorageReader(db_path, limits)
    try:
        counts = {table: reader.one(f"SELECT count(*) FROM {table}")[0] for table in ("sessions", "launches", "events", "feature_snapshots", "data_quality_intervals", "provider_observations", "system_events")}  # type: ignore[index]
        last_session = reader.one("SELECT id, persistent_session_sequence, mode, final_state, started_at_utc_ns, ended_at_utc_ns, data_complete FROM sessions ORDER BY persistent_session_sequence DESC LIMIT 1")
        health = reader.one("SELECT utc_ns, details_json FROM system_events WHERE event_type = 'HEALTH' ORDER BY id DESC LIMIT 1")
        intervals = reader.all("SELECT reason, count(*) FROM data_quality_intervals GROUP BY reason")
        print(json.dumps({"db": str(db_path), "counts": counts, "last_session": last_session, "open_or_closed_intervals": intervals, "last_health": json.loads(health[1]) if health else None}, indent=2, default=str))
    finally:
        reader.close()
    return EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="darkbot.main")
    sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", help="start the bot in one mode")
    run.add_argument("--mode", required=True, choices=[mode.value for mode in Mode])
    run.add_argument("--chain-ws-url", default=None, help="Solana websocket endpoint; defaults to $DARKBOT_CHAIN_WS_URL")
    run.add_argument("--commitment", default=None, help="processed (default) or confirmed")
    run.add_argument("--pumpportal", action="store_true", help="also listen to PumpPortal subscribeNewToken as a free cross-check")
    run.add_argument("--pumpportal-ws-url", default=None, help="PumpPortal websocket endpoint (wss://...); defaults to $DARKBOT_PUMPPORTAL_WS_URL")
    run.add_argument("--db", type=Path, default=None)
    run.add_argument("--project-root", type=Path, default=None)
    run.add_argument("--strategy", type=Path, default=None, help="shared StrategyConfig JSON; required for PAPER")
    run.add_argument("--protocol-fee-config", type=Path, default=None, help="Pump protocol fee snapshot JSON; required for PAPER")
    run.add_argument("--max-open-positions", type=int, default=1, help="PAPER slot limit")
    run.add_argument("--account-rent-lamports", type=int, default=0, help="explicit PAPER account-rent assumption")
    status = sub.add_parser("status", help="read-only summary of the database")
    status.add_argument("--db", type=Path, default=None)
    status.add_argument("--project-root", type=Path, default=None)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "run":
            return command_run(args)
        if args.command == "status":
            return command_status(args)
    except (ContractError, ConfigError) as exc:
        print(str(exc), file=sys.stderr)
        return EXIT_CONFIG
    return EXIT_CONFIG


if __name__ == "__main__":
    sys.exit(main())
